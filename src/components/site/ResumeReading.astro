---
import type { ReadingPost } from "@/utils/reading-memory";

interface Props {
	posts: ReadingPost[];
}

const { posts } = Astro.props;
---

<aside class="resume-reading" data-resume-reading data-reading-posts={JSON.stringify(posts)} hidden data-pagefind-ignore aria-label="上次阅读">
	<div>
		<p class="resume-label">接着上次的思路</p>
		<a class="resume-title" data-resume-link></a>
		<p class="resume-detail" data-resume-detail></p>
	</div>
	<a class="resume-action" data-resume-action>继续阅读</a>
</aside>

<style>
	.resume-reading { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; padding: 20px; background: var(--card); border: 1px solid var(--hair); border-radius: var(--radius); }
	.resume-reading > div { width: 100%; min-width: 0; }
	.resume-label { margin: 0 0 8px; color: var(--ink-soft); font-size: 13px; }
	.resume-title { color: var(--ink); font-weight: 650; line-height: 1.65; text-decoration: none; }
	.resume-title:hover { color: var(--accent); }
	.resume-detail { margin: 8px 0 0; font-size: 12px; line-height: 1.6; color: var(--ink-soft); }
	.resume-action { flex-shrink: 0; display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px; border-radius: var(--radius-sm); background: var(--accent-wash); color: var(--accent-deep); text-decoration: none; font-size: 14px; }
	.resume-action:hover { background: color-mix(in srgb, var(--accent) 15%, var(--card)); }
	@media (max-width: 600px) { .resume-reading { padding: 16px; gap: 12px; } .resume-action { padding: 0 12px; font-size: 13px; } }
</style>

<script>
	import { READING_MEMORY_KEY, readReadingMemory, type ReadingPost } from "@/utils/reading-memory";

	const panel = document.querySelector<HTMLElement>("[data-resume-reading]");
	if (panel) {
		let posts: ReadingPost[] = [];
		try {
			const raw: unknown = JSON.parse(panel.dataset.readingPosts ?? "[]");
			if (Array.isArray(raw)) {
				posts = raw.filter((post): post is ReadingPost =>
					!!post && typeof post === "object" && typeof post.id === "string" && typeof post.title === "string",
				);
			}
		} catch { /* Keep the optional panel hidden when the catalog is unavailable. */ }

		function updateResume(): void {
			if (!panel) return;
			const memory = readReadingMemory(posts);
			panel.hidden = !memory || memory.progress < 0.01;
			if (!memory || panel.hidden) return;
			const title = panel.querySelector<HTMLAnchorElement>("[data-resume-link]");
			const action = panel.querySelector<HTMLAnchorElement>("[data-resume-action]");
			const detail = panel.querySelector<HTMLElement>("[data-resume-detail]");
			if (title) { title.textContent = memory.title; title.href = memory.path; }
			if (action) action.href = memory.path;
			if (detail) detail.textContent = `上次读到 ${Math.round(memory.progress * 100)}%，进入文章后可恢复位置。`;
		}

		updateResume();
		window.addEventListener("pageshow", updateResume);
		window.addEventListener("storage", (event) => { if (event.key === READING_MEMORY_KEY || event.key === null) updateResume(); });
	}
</script>
