---
import { commentConfig } from "@/config";
interface Props {
	path: string;
}
const config = {
	...commentConfig.waline,
	el: "#waline",
	path: Astro.props.path,
	dark: "html.dark",
	pageview: commentConfig.waline?.visitorCount ?? false,
	wordLimit: commentConfig.waline?.wordLimit ?? [2, 300],
};
---
<div id="waline-section"><div id="waline"></div><p id="comment-state" role="status">评论将在滚动到此处时加载。</p><button id="comment-retry" type="button" hidden>重新加载评论</button><noscript><p>评论需要启用 JavaScript；也可以通过页脚邮件联系。</p></noscript></div>
<script type="module" is:inline define:vars={{ config }}>
 const host = document.getElementById("waline-section");
 const state = document.getElementById("comment-state");
 const retry = document.getElementById("comment-retry");
 let loading = false;
 let loaded = false;
 let attempts = 0;
 async function load() {
  if (loaded || loading) return;
  loading = true; retry.hidden = true; state.hidden = false; state.textContent = "正在加载评论…";
  try {
   if (!document.getElementById("waline-style")) {
    const style = document.createElement("link"); style.id = "waline-style"; style.rel = "stylesheet"; style.href = "https://unpkg.com/@waline/client@v3/dist/waline.css"; document.head.append(style);
   }
   const url = "https://unpkg.com/@waline/client@v3/dist/waline.js";
   const { init } = await import(attempts++ ? `${url}?retry=${attempts}` : url);
   const requestedPath = location.pathname.startsWith("/dynamic/comments") ? new URLSearchParams(location.search).get("path") : null;
   init({ ...config, path: requestedPath?.startsWith("/dynamic/") ? requestedPath : config.path });
   loaded = true; state.hidden = true;
  } catch { state.textContent = "评论暂时无法加载，请重试或通过邮件联系。"; retry.hidden = false; }
  finally { loading = false; }
 }
 retry.addEventListener("click", load);
 if ("IntersectionObserver" in window) { const observer = new IntersectionObserver(entries => { if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); load(); } }, { rootMargin: "200px" }); observer.observe(host); } else { load(); }
</script>
<style is:global>#waline { --waline-theme-color: var(--accent-deep); --waline-bg-color: var(--card); --waline-color: var(--ink); --waline-info-color: var(--ink-soft); } #comment-state { color: var(--ink-soft); font-size: 14px; } #comment-retry { padding: 10px 16px; color: var(--ink); background: var(--card); border: 1px solid var(--hair); border-radius: 8px; }</style>
