---
import type { CollectionEntry } from "astro:content";
import { commentConfig } from "@/config/commentConfig";
import Waline from "./Waline.astro";
interface Props {
	post?: CollectionEntry<"posts"> | CollectionEntry<"spec">;
	customPath?: string;
	title?: string;
}
const { post, customPath } = Astro.props;
const path =
	customPath ||
	(post
		? post.collection === "posts"
			? `/posts/${post.id}`
			: `/${post.id}`
		: Astro.url.pathname.replace(/\/$/, "") || "/");
---
{commentConfig.type === "waline" && <section id="post-comments" class="site-comments"><h2>讨论</h2><Waline path={path} /></section>}
<style>.site-comments { margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--hair); }.site-comments h2 { margin: 0 0 16px; font-size: 20px; }</style>
