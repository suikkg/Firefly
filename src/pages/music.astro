---
import SitePage from "@/layouts/SitePage.astro";
const lists = [
	{ name: "粤语经典 · 歌单一", id: "PLDX7UghaEhS3tozBn2fQvxv9emsBO3Fd8" },
	{ name: "粤语经典 · 歌单二", id: "PLbdmiTuJcvXqiaN0oQVSXCUsF7DIapKhg" },
];
---
<SitePage title="音乐" lede="一些收藏的歌单。播放器在点击后加载，播放能力取决于平台与当前网络。">
 <div class="playlists">{lists.map(list => <section class="playlist"><h2>{list.name}</h2><p><a href={`https://www.youtube.com/playlist?list=${list.id}`} target="_blank" rel="noopener noreferrer">在 YouTube 打开</a></p><button type="button" data-playlist={list.id} data-title={list.name}>加载播放器</button><div class="player"></div></section>)}</div>
</SitePage>
<script>
 for (const button of document.querySelectorAll<HTMLButtonElement>("[data-playlist]")) {
  button.addEventListener("click", () => { const frame = document.createElement("iframe"); frame.src = `https://www.youtube-nocookie.com/embed/videoseries?list=${button.dataset.playlist}`; frame.title = button.dataset.title || "歌单播放器"; frame.allow = "encrypted-media; picture-in-picture"; frame.allowFullscreen = true; button.parentElement?.querySelector(".player")?.append(frame); button.hidden = true; });
 }
</script>
<style>.playlists { display:grid; gap:32px; }.playlist { padding:24px; border:1px solid var(--hair); border-radius:12px; background:var(--card); }.playlist h2 { font-size:22px; margin:0; }.playlist p { font-size:14px; }.playlist button { padding:12px 20px; border:1px solid var(--hair); border-radius:8px; color:var(--ink); background:var(--accent-wash); }.player :global(iframe) { width:100%; aspect-ratio:16 / 9; border:0; display:block; }.player:empty { display:none; }</style>
