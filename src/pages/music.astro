---
// 音乐：YouTube 歌单嵌入
import { Icon } from "astro-icon/components";
import LabPage from "@/layouts/LabPage.astro";

// 歌单 ID 取法：YouTube 打开歌单 → 地址栏 list= 后面的参数
const YOUTUBE_PLAYLISTS = [
	{ name: "粤语经典 歌单一", id: "PLDX7UghaEhS3tozBn2fQvxv9emsBO3Fd8" },
	{ name: "粤语经典 歌单二", id: "PLbdmiTuJcvXqiaN0oQVSXCUsF7DIapKhg" },
];

const description = "在线歌单，登录 YouTube 账号后可无广告完整播放。";
---

<LabPage title="音乐" description={description} lede={description}>
	{
		YOUTUBE_PLAYLISTS.length > 0 ? (
			<div class="lists">
				{YOUTUBE_PLAYLISTS.map((pl) => (
					<section class="list">
						<h2 class="list-name">
							<Icon is:inline name="lucide:list-music" />
							{pl.name}
						</h2>
						<div class="frame card">
							<iframe
								src={`https://www.youtube.com/embed/videoseries?list=${pl.id}`}
								title={pl.name}
								loading="lazy"
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
								allowfullscreen
							/>
						</div>
					</section>
				))}
			</div>
		) : (
			<p class="empty">
				<Icon is:inline name="lucide:music" />
				还没有配置歌单
			</p>
		)
	}

	<div class="notes">
		<p>
			<Icon is:inline name="lucide:headphones" />
			<span>登录你的 YouTube 账号（Premium 会员）后可无广告完整播放；未登录时部分歌曲可能插播广告。</span>
		</p>
		<p>
			<Icon is:inline name="lucide:radio" />
			<span>侧边栏的音乐播放器播放本地音乐，无需登录、没有广告，歌曲在 <code>src/config/musicConfig.ts</code> 中配置。</span>
		</p>
	</div>
</LabPage>

<style>
	.lists { display: grid; gap: clamp(1.5rem, 4vw, 2.5rem); }

	.list-name {
		display: flex; align-items: center; gap: 0.55rem;
		margin: 0 0 0.85rem;
		font-size: 1.15rem; font-weight: 650; letter-spacing: -0.015em;
	}
	.list-name :global(svg) { color: var(--accent-deep); }

	.frame { overflow: hidden; }

	.frame :global(iframe) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		min-height: 320px;
		border: 0;
	}

	.notes {
		display: grid; gap: 0.85rem;
		max-width: var(--measure);
		margin-top: clamp(2rem, 5vw, 3rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--hair);
	}

	.notes p {
		display: flex; align-items: flex-start; gap: 0.6rem;
		margin: 0; font-size: 0.88rem; line-height: 1.7; color: var(--ink-soft);
	}

	.notes :global(svg) { margin-top: 0.25rem; flex-shrink: 0; color: var(--accent-deep); }

	.notes :global(code) {
		font-family: var(--mono); font-size: 0.85em;
		padding: 0.1em 0.35em; border-radius: 3px; background: var(--accent-wash);
	}

	.empty {
		display: flex; align-items: center; justify-content: center; gap: 0.5rem;
		padding: 3.5rem 1rem; color: var(--ink-soft);
	}
</style>
