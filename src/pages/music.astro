---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// ============================================================
// YouTube 音乐歌单页面（方案A）
// 访客可自行登录自己的 YouTube 账号（Premium 会员则无广告）
//
// 支持多个歌单，每个歌单一个嵌入播放器
// 歌单 ID 获取方法：
//   YouTube 打开歌单 -> 地址栏 URL 中 list= 后面的参数
//   例如 https://www.youtube.com/playlist?list=PLxxxxxxxxxx
//   则填入 "PLxxxxxxxxxx"
// ============================================================
const YOUTUBE_PLAYLISTS = [
	{
		name: "粤语经典 歌单一",
		id: "PLDX7UghaEhS3tozBn2fQvxv9emsBO3Fd8",
	},
	{
		name: "粤语经典 歌单二",
		id: "PLLlhPNUoErKZ9j6QEWn1NvGzuQsXX6LUt",
	},
];

const title = "音乐";
const description = "YouTube 歌单播放，登录你的 YouTube 账号可无广告完整播放";
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题和描述 -->
      <div class="mb-4">
        <div class="flex items-center gap-3 mb-3">
          <div
            class="h-8 w-8 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70"
          >
            <Icon is:inline name="material-symbols:music-note" class="text-[1.5rem]" />
          </div>
          <div class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            {title}
          </div>
        </div>
        <p class="text-base text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          {description}
        </p>
      </div>

      {
        YOUTUBE_PLAYLISTS.length > 0 ? (
          <div class="space-y-8">
            {YOUTUBE_PLAYLISTS.map((playlist) => (
              <div>
                <h3 class="mb-3 text-lg font-bold text-neutral-800 dark:text-neutral-100">
                  🎵 {playlist.name}
                </h3>
                <p class="mb-3 text-sm text-neutral-500 dark:text-neutral-400">
                  🎧 提示：登录你的 YouTube 账号（Premium 会员）后可无广告完整播放；
                  未登录时部分歌曲可能插播广告。
                </p>
                <div class="overflow-hidden rounded-xl bg-black/5 dark:bg-white/5">
                  <iframe
                    src={`https://www.youtube.com/embed/videoseries?list=${playlist.id}`}
                    class="h-[480px] w-full border-0"
                    title={playlist.name}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                  ></iframe>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="py-12 text-center">
            <p class="text-lg text-neutral-700 dark:text-neutral-200">
              🎵 音乐页面即将上线
            </p>
            <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
              请先在 <code>src/pages/music.astro</code> 中填入你的 YouTube 歌单 ID
            </p>
          </div>
        )
      }

      <!-- 本地音乐说明 -->
      <div class="mt-6 rounded-xl border border-neutral-200 dark:border-neutral-700 p-4 text-sm text-neutral-500 dark:text-neutral-400">
        📻 侧边栏的音乐播放器播放本地音乐（无需登录，无广告），
        如需调整歌曲请修改 <code>src/config/musicConfig.ts</code> 的本地播放列表。
      </div>
    </div>
  </div>
</MainGridLayout>
