---
// 留言板：spec/guestbook 的内容 + 评论区
import { getEntry, render } from "astro:content";
import Comment from "@/components/comment/index.astro";
import { commentConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
import "@/styles/lab-prose.css";

if (!siteConfig.pages.guestbook) {
	return Astro.redirect("/404/");
}

const guestbookPost = await getEntry("spec", "guestbook");
if (!guestbookPost) {
	throw new Error("guestbook page content not found");
}
const { Content } = await render(guestbookPost);

const isCommentEnabled = !!commentConfig?.type && commentConfig.type !== "none";

const title = i18n(I18nKey.guestbook);
const description = i18n(I18nKey.guestbookDescription);
---

<LabPage title={title} description={description} lede={description}>
	<article class="prose lab-prose flush">
		<Content />
	</article>

	{
		isCommentEnabled ? (
			<section class="comments">
				<h2 class="comments-title micro">留言</h2>
				<Comment customPath="/guestbook" title={title} />
			</section>
		) : (
			<p class="notice">评论系统未启用，留言功能暂不可用。</p>
		)
	}
</LabPage>

<style>
	/* 内容区已有左右留白，正文自身不再重复 */
	.flush { padding-left: 0; padding-right: 0; }

	.comments { margin-top: clamp(2.5rem, 6vw, 4rem); }

	.comments-title {
		margin: 0 0 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--hair);
	}

	.comments :global(#post-comments) { max-width: var(--measure); }
	.comments :global(#post-comments > .absolute) { display: none; }

	.notice {
		padding: 3rem 1rem;
		text-align: center;
		color: var(--ink-soft);
	}
</style>
