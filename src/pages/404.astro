---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
---

<LabPage
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
	lede={i18n(I18nKey.notFoundDescription)}
>
	<div class="nf">
		<span class="nf-code">404</span>
		<p class="nf-text">这个地址上没有内容。可能已经移动，或者从来就不存在。</p>
		<div class="nf-actions">
			<a class="btn primary" href="/">
				<Icon is:inline name="lucide:house" />
				<span>回到首页</span>
			</a>
			<a class="btn" href="/archive/">
				<Icon is:inline name="lucide:archive" />
				<span>浏览归档</span>
			</a>
			<a class="btn" href="/search/">
				<Icon is:inline name="lucide:search" />
				<span>搜索</span>
			</a>
		</div>
	</div>
</LabPage>

<style>
	.nf {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding: clamp(2rem, 8vw, 5rem) 1rem;
		text-align: center;
	}

	/* 数字大而淡，作为图形而不是可读文本 */
	.nf-code {
		font-family: var(--mono);
		font-size: clamp(5rem, 20vw, 12rem);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.05em;
		color: transparent;
		-webkit-text-stroke: 2px var(--accent);
		opacity: 0.55;
		user-select: none;
	}

	.nf-text {
		max-width: 34ch;
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.75;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.nf-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 0.5rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.15rem;
		border-radius: 999px;
		background: var(--card);
		box-shadow: var(--lift-1);
		color: var(--ink);
		font-size: 0.88rem;
		text-decoration: none;
		transition:
			transform 0.4s var(--spring),
			box-shadow 0.4s var(--ease-out),
			background-color 0.3s var(--ease-out),
			color 0.3s var(--ease-out);
	}

	.btn:hover {
		transform: translateY(-2px);
		box-shadow: var(--lift-2);
	}

	.btn.primary { background: var(--accent); color: #fff; }
	.btn.primary:hover { background: var(--accent-deep); }
</style>
