---
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import CharacterHero from "@/components/site/CharacterHero.astro";
import PostList from "@/components/site/PostList.astro";
import ResumeReading from "@/components/site/ResumeReading.astro";
import { personalConfig, profileConfig, siteConfig } from "@/config";
import SitePage from "@/layouts/SitePage.astro";
import { getSortedPostsList } from "@/utils/content-utils";
export const getStaticPaths = (async ({ paginate }) => {
	const posts = (await getSortedPostsList()).sort(
		(a, b) => b.data.published.getTime() - a.data.published.getTime(),
	);
	return paginate(posts, { pageSize: siteConfig.pagination.postsPerPage });
}) satisfies GetStaticPaths;
const { page } = Astro.props;
const first = page.currentPage === 1;
const posts = await getSortedPostsList();
const contacts = profileConfig.links.filter((link) =>
	["GitHub", "Email"].includes(link.name),
);
---
<SitePage title={first ? "个人博客" : `文章 · 第 ${page.currentPage} 页`} description={siteConfig.description} intro={!first}>
	{first && <section class="home-intro" aria-labelledby="home-title">
		<div><h1 id="home-title">{personalConfig.headline}</h1><p>{personalConfig.introduction}</p></div>
		<a href="/about/" class="about-link">关于我 <Icon name="lucide:arrow-up-right" /></a>
	</section>}
	{first && <CharacterHero />}
	<div class="notebook-grid">
		<section id="recent-notes" class="recent-notes" aria-labelledby="recent-title">
			<div class="section-heading"><h2 id="recent-title">最近文章</h2><a href="/archive/">全部文章 <Icon name="lucide:arrow-up-right" /></a></div>
			<p class="topic-notice" id="topic-notice" hidden><a id="topic-archive" href="/archive/">到归档查看该分类的全部文章</a></p>
			<p class="list-summary">共 {posts.length} 篇 · 第 {page.currentPage} / {page.lastPage} 页</p>
			<PostList posts={page.data} />
			{page.lastPage > 1 && <nav class="home-pager" aria-label="文章分页">{page.url.prev ? <a href={page.url.prev}>上一页</a> : <span>已到首页</span>}<span>第 {page.currentPage} / {page.lastPage} 页</span>{page.url.next ? <a href={page.url.next}>下一页</a> : <span>已到末页</span>}</nav>}
		</section>
		<aside class="personal-margin" aria-label="更多入口">
			<ResumeReading posts={posts.map(post => ({ id: post.id, title: post.data.title }))} />
			<nav class="explore-links" aria-label="查找文章"><a href="/tags/"><Icon name="lucide:tag" /><span>按标签查找</span><Icon name="lucide:arrow-up-right" /></a><a href="/series/"><Icon name="lucide:library" /><span>专题</span><Icon name="lucide:arrow-up-right" /></a><a href="/archive/"><Icon name="lucide:archive" /><span>文章归档</span><Icon name="lucide:arrow-up-right" /></a></nav>
			<section class="life-insert"><div class="life-orbit" aria-hidden="true"><span></span><i></i></div><h2>生活</h2><nav aria-label="生活入口">{siteConfig.pages.gallery && <a href="/gallery/">相册</a>}<a href="/music/">音乐</a><a href="/life/">生活</a></nav></section>
			<nav class="margin-contact" aria-label="作者链接">{contacts.map(link => <a href={link.url}>{link.name === "Email" ? "邮件" : "GitHub"}</a>)}<a href="/rss/">订阅更新</a></nav>
		</aside>
	</div>
</SitePage>
<style>
.home-intro { display: flex; gap: 24px; justify-content: space-between; align-items: center; padding: 0 0 20px; margin-bottom: 0; }
.home-intro h1 { font-size: clamp(28px, 3.4vw, 40px); line-height: 1.5; letter-spacing: -0.045em; margin: 0 0 12px; font-weight: 650; }
.home-intro p { font-size: 14px; line-height: 1.9; color: var(--ink-soft); margin: 0; }
.about-link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; white-space: nowrap; text-decoration: none; font-size: 13px; }
.section-heading { display: flex; gap: 16px; align-items: baseline; justify-content: space-between; margin-bottom: 12px; }
.section-heading h2 { font-size: 20px; font-weight: 650; margin: 0; }.section-heading > a { display: inline-flex; gap: 6px; align-items: center; min-height: 44px; font-size: 12px; text-decoration: none; }
.list-summary { margin: 0 0 8px; color: var(--ink-soft); font-size: 11px; }.topic-notice { margin: 0 0 16px; padding: 12px 16px; border-radius: 8px; background: var(--accent-wash); font-size: 13px; line-height: 1.8; }.topic-notice a { display: inline-flex; align-items: center; min-height: 44px; }
.notebook-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: clamp(32px, 5vw, 64px); align-items: start; }.personal-margin { display: grid; gap: 32px; }
.explore-links { border-block: 1px solid var(--hair); }.explore-links a { display: flex; gap: 12px; align-items: center; min-height: 52px; padding-block: 12px; text-decoration: none; color: var(--ink); font-size: 13px; }.explore-links svg { width: 16px; color: var(--ink-soft); }.explore-links svg:last-child { margin-left: auto; }.explore-links a + a { border-top: 1px solid var(--hair); }.explore-links a:hover { color: var(--accent); }
.life-insert { background: var(--life-wash); border-radius: 12px; padding: 24px; }.life-insert h2 { font-size: 16px; font-weight: 600; margin: 14px 0; }.life-orbit { position: relative; height: 36px; }.life-orbit span { display: block; width: 58px; height: 30px; border: 1px solid var(--iris); border-radius: 50%; transform: rotate(-24deg); }.life-orbit i { position: absolute; top: 0; left: 12px; width: 20px; height: 20px; background: var(--iris); border-radius: 50%; }.life-insert nav { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 14px; }.life-insert a { font-size: 12px; min-height: 44px; display: grid; place-items: center; text-decoration: none; }
.margin-contact { display: flex; flex-wrap: wrap; gap: 16px; }.margin-contact a { font-size: 12px; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
.home-pager { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 20px; margin-top: 20px; border-top: 1px solid var(--hair); color: var(--ink-soft); font-size: 12px; }.home-pager a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; }
@media (max-width: 760px) { .home-intro { padding: 0 0 20px; margin-bottom: 0; }.notebook-grid { grid-template-columns: 1fr; gap: 40px; }.personal-margin { grid-template-columns: 1fr 1fr; }.margin-contact { grid-column: 1 / -1; } }
@media (max-width: 520px) { .home-intro { align-items: flex-start; gap: 12px; }.home-intro h1 { font-size: 28px; }.about-link { font-size: 12px; margin-top: 2px; }.section-heading { align-items: center; }.section-heading h2 { font-size: 18px; }.personal-margin { grid-template-columns: 1fr; gap: 26px; }.margin-contact { grid-column: auto; } }
</style>
<script>
	const topic = new URLSearchParams(location.search).get("topic")?.trim();
	const notice = document.getElementById("topic-notice");
	const archive = document.getElementById("topic-archive") as HTMLAnchorElement | null;
	if (topic && notice && archive) {
		archive.href = `/archive/?category=${encodeURIComponent(topic)}`;
		archive.textContent = `查看“${topic.slice(0, 120)}”分类的全部文章`;
		notice.hidden = false;
	}
</script>
