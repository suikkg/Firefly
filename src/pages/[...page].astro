---
// ─────────────────────────────────────────────────────────────────────────
// 首页
// 保留站点原本的底子：插画当主角、浅色薄荷调、白色圆角卡片浮在壁纸上。
// 加法做在排版精度、编排层次和动效上。
// ─────────────────────────────────────────────────────────────────────────
import type { GetStaticPaths } from "astro";
import { Icon } from "astro-icon/components";
import LabHead from "@/components/lab/LabHead.astro";
import { backgroundWallpaper, siteConfig } from "@/config";
import { getSortedPostsList } from "@/utils/content-utils";
import { hueFromString, usableImage } from "@/utils/lab-utils";
import "@/styles/lab.css";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedPostsList();
	const items = posts.map((post, index) => ({
		index,
		title: post.data.title,
		postUrl: `/posts/${post.id}/`,
		category: post.data.category || "未分类",
		tags: post.data.tags,
		description: post.data.description,
		published: post.data.published,
		image: usableImage(post.data.image),
		hue: hueFromString(post.data.title),
	}));
	return paginate(items, {
		pageSize: siteConfig.pagination?.postsPerPage ?? 8,
	});
}) satisfies GetStaticPaths;

type Item = {
	index: number;
	title: string;
	postUrl: string;
	category: string;
	tags: string[];
	description: string;
	published: Date;
	image: string;
	hue: number;
};

const { page } = Astro.props as {
	page: {
		data: Item[];
		currentPage: number;
		lastPage: number;
		url: { prev?: string; next?: string };
	};
};

const isFirstPage = page.currentPage === 1;

// 搜索要跨全部文章，不能只认当前这一页，所以另外备一份完整索引。
// 十几到几百篇的量级，内联进页面比再发一次请求划算。
const allPosts = await getSortedPostsList();
const searchIndex = allPosts.map((post) => ({
	t: post.data.title,
	g: post.data.tags,
	c: post.data.category || "未分类",
	u: `/posts/${post.id}/`,
	d: post.data.published.toISOString().slice(0, 10),
	i: usableImage(post.data.image),
	h: hueFromString(post.data.title),
}));

const homeText = backgroundWallpaper.common?.homeText;
const displayTitle = homeText?.title || siteConfig.title || "KK";
const displaySubtitle = siteConfig.subtitle || "";
const subtitles = Array.isArray(homeText?.subtitle)
	? homeText.subtitle
	: [homeText?.subtitle].filter(Boolean);

// 按词分组再拆字：换行只发生在词与词之间，不会把单词劈开
const titleTokens = displayTitle
	.split(/(\s+)/)
	.filter((w) => w.trim().length > 0)
	.map((word) => [...word]);
let charCursor = 0;

/** 壁纸配置可能是字符串、数组，或 { desktop, mobile, playerUrl } */
function pickWallpaper(kind: "desktop" | "mobile"): string {
	const src = backgroundWallpaper.src;
	if (!src) return "";
	const first = (v: string | string[] | undefined): string =>
		Array.isArray(v) ? (v[0] ?? "") : (v ?? "");
	if (typeof src === "string") return src;
	if (Array.isArray(src)) return first(src);
	return first(src[kind]) || first(src.desktop);
}
// 手机上用竖版壁纸：横版图在窄高视口里被 cover 裁掉大半，人物基本看不见
const wallpaperDesktop = pickWallpaper("desktop");
const wallpaperMobile = pickWallpaper("mobile");

// 首页第一页才给特稿位；翻页之后统一走网格
const feature = isFirstPage ? page.data[0] : undefined;
const rest = isFirstPage ? page.data.slice(1) : page.data;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<html lang="zh-CN">
	<head>
		<LabHead />
		{wallpaperDesktop && (
			<link
				rel="preload"
				as="image"
				href={wallpaperDesktop}
				media="(min-width: 769px)"
				fetchpriority="high"
			/>
		)}
		{wallpaperMobile && (
			<link
				rel="preload"
				as="image"
				href={wallpaperMobile}
				media="(max-width: 768px)"
				fetchpriority="high"
			/>
		)}
	</head>

	<body>
		<!-- 壁纸固定在最底层，内容区半透明浮在上面 —— 和现有主题的 overlay 模式同源 -->
		<div
			class="wallpaper"
			style={`--wp-desktop:url("${wallpaperDesktop}"); --wp-mobile:url("${wallpaperMobile || wallpaperDesktop}")`}
			aria-hidden="true"
		></div>

		<header class="hero">
			<div class="hero-bar">
				<nav class="hero-nav">
					<span class="hero-brand">
						<Icon is:inline name="lucide:sparkles" />
						{siteConfig.title}
					</span>
					<a href="/archive/">归档</a>
					<a href="/categories/">分类</a>
					<a href="/tags/">标签</a>
					<a href="/about/">关于</a>
				</nav>
				<div class="hero-actions">
					<a href="/classic/" class="circle-btn" aria-label="旧版界面" title="旧版界面">
						<Icon is:inline name="lucide:layout-panel-left" />
					</a>
					<button id="theme-toggle" class="circle-btn" type="button" aria-label="切换明暗">
						<Icon is:inline name="lucide:sun-moon" />
					</button>
				</div>
			</div>

			<div class="hero-center">
				<h1 class="display">
					{
						titleTokens.map((chars) => (
							<span class="word">
								{chars.map((char) => (
									<span class="char" style={`--i:${charCursor++}`}>
										{char}
									</span>
								))}
							</span>
						))
					}
				</h1>
				{subtitles[0] && <p class="display-sub">{subtitles[0]}</p>}
			</div>

			<div class="hero-foot">
				<span class="micro hero-count">{String(allPosts.length).padStart(3, "0")} 篇文章</span>
				<a href="#index" class="scroll-cue" aria-label="向下滚动">
					<span class="micro">向下滚动</span>
					<Icon is:inline name="lucide:arrow-down" />
				</a>
			</div>
		</header>

		<main class="sheet" id="index">
			<div class="sheet-inner">
				<div class="sheet-head">
					<h2 class="sheet-title">文章</h2>
					<div class="search" role="search">
						<Icon is:inline name="lucide:search" class="search-icon" />
						<input
							id="search-input"
							type="search"
							placeholder="搜索标题或标签…"
							autocomplete="off"
							aria-label="搜索文章"
						/>
						<button id="search-clear" type="button" aria-label="清空搜索" hidden>
							<Icon is:inline name="lucide:x" />
						</button>
					</div>
				</div>

				<!-- 搜索结果：有输入时顶掉下面的分页网格 -->
				<div id="search-results" hidden>
					<p class="search-summary micro" id="search-summary"></p>
					<div class="grid" id="search-grid"></div>
				</div>

				<div id="browse">
				{
					feature && (
						<a class="feature card" href={feature.postUrl} data-reveal>
							<div
								class="feature-art"
								style={
									feature.image
										? `background-image:url("${feature.image}")`
										: `background-image:linear-gradient(145deg, oklch(0.82 0.11 ${feature.hue}), oklch(0.62 0.13 ${feature.hue + 40}))`
								}
							/>
							<div class="feature-body">
								<span class="micro feature-kicker">
									<span class="dot" />
									特稿 · {feature.category}
								</span>
								<h3 class="feature-title">{feature.title}</h3>
								{feature.description && <p class="feature-desc">{feature.description}</p>}
								<div class="feature-meta micro">
									<span>{dateFormatter.format(feature.published)}</span>
									<span class="feature-go">
										阅读 <Icon is:inline name="lucide:arrow-right" />
									</span>
								</div>
							</div>
						</a>
					)
				}

				<div class="grid">
					{
						rest.map((item) => (
							<a
								class:list={["tile", "card", item.image ? "has-art" : "no-art"]}
								href={item.postUrl}
								data-reveal
							>
								{item.image ? (
									<div class="tile-art" style={`background-image:url("${item.image}")`}>
										<span class="tile-num micro">{String(item.index + 1).padStart(2, "0")}</span>
									</div>
								) : (
									/* 没封面就不要拿假渐变块充数：给文字型卡片，
									   让网格在图文之间形成节奏，而不是一片糊墙纸 */
									<div class="tile-plate">
										<span class="tile-num-plain">{String(item.index + 1).padStart(2, "0")}</span>
									</div>
								)}
								<div class="tile-body">
									<span class="micro tile-cat">{item.category}</span>
									<h3 class="tile-title">{item.title}</h3>
									{!item.image && item.description && (
										<p class="tile-desc">{item.description}</p>
									)}
									<div class="tile-foot micro">
										<span>{dateFormatter.format(item.published)}</span>
										<Icon is:inline name="lucide:arrow-up-right" class="tile-arrow" />
									</div>
								</div>
							</a>
						))
					}
				</div>

				{
					page.lastPage > 1 && (
						<nav class="pager" aria-label="分页">
							{page.url.prev ? (
								<a href={page.url.prev} class="pager-btn" rel="prev">
									<Icon is:inline name="lucide:arrow-left" />
									<span>上一页</span>
								</a>
							) : (
								<span class="pager-btn is-disabled" aria-hidden="true">
									<Icon is:inline name="lucide:arrow-left" />
									<span>上一页</span>
								</span>
							)}

							<span class="pager-now micro">
								{String(page.currentPage).padStart(2, "0")} / {String(page.lastPage).padStart(2, "0")}
							</span>

							{page.url.next ? (
								<a href={page.url.next} class="pager-btn" rel="next">
									<span>下一页</span>
									<Icon is:inline name="lucide:arrow-right" />
								</a>
							) : (
								<span class="pager-btn is-disabled" aria-hidden="true">
									<span>下一页</span>
									<Icon is:inline name="lucide:arrow-right" />
								</span>
							)}
						</nav>
					)
				}
				</div>
			</div>
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<span class="micro">{displaySubtitle}</span>
				<a href="/classic/" class="footer-back">
					<Icon is:inline name="lucide:layout-panel-left" />
					<span>切换到旧版界面</span>
				</a>
			</div>
		</footer>

		<style>
			/* ── 壁纸层 ─────────────────────────────────────────── */
			.wallpaper {
				position: fixed;
				inset: 0;
				z-index: -1;
				background-image: var(--wp-desktop);
				background-size: cover;
				background-position: center 20%;
			}

			/* 手机上换竖版壁纸。横版图放进窄高视口，cover 会把左右裁掉大半，
			   人物基本只剩一角 */
			@media (max-width: 768px) {
				.wallpaper {
					background-image: var(--wp-mobile);
					background-position: center top;
				}
			}

			/* 注意：底纹不能挂在这个固定层上。挂在这里的话渐变是相对视口的，
			   一滚动，视口上半部分又变回全透明，卡片就直接压在原图上了。
			   正确做法是让底纹跟着内容一起滚——见 .sheet */

			/* ── Hero ───────────────────────────────────────────── */
			.hero {
				position: relative;
				z-index: 1;
				min-height: 100svh;
				display: grid;
				grid-template-rows: auto 1fr auto;
				gap: 2rem;
				padding: 1.5rem var(--gutter) 2.5rem;
			}

			.hero-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.hero-brand {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				font-size: 0.9rem;
				font-weight: 650;
				letter-spacing: -0.01em;
			}

			.hero-brand :global(svg) { color: var(--accent-deep); }

			.hero-nav {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				min-width: 0;
			}

			/* 窄屏让导航横向滚动，而不是折成两排把整个 hero-bar 撑高 */
			@media (max-width: 640px) {
				.hero-nav {
					overflow-x: auto;
					scrollbar-width: none;
					-webkit-overflow-scrolling: touch;
				}
				.hero-nav::-webkit-scrollbar { display: none; }
				.hero-nav > * { flex-shrink: 0; }
			}

			.hero-nav a {
				padding: 0.5rem 0.85rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				font-size: 0.82rem;
				color: var(--ink);
				text-decoration: none;
				transition:
					background-color 0.3s var(--ease-out),
					color 0.3s var(--ease-out);
			}

			.hero-nav a:hover {
				background: var(--accent);
				color: #fff;
			}

			.hero-actions { display: flex; gap: 0.6rem; }

			.hero-center {
				align-self: center;
				text-align: center;
			}

			/* 大标题压在插画上，用两层阴影保清晰：近处一层实的收边缘，
			   远处一层虚的把字从繁杂画面里托起来 */
			.display {
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0 0.26em;
				font-size: clamp(2.6rem, 8.5vw, 7.5rem);
				font-weight: 800;
				line-height: 0.98;
				letter-spacing: -0.035em;
				color: #fff;
				text-shadow:
					0 1px 2px rgb(20 40 34 / 0.34),
					0 10px 40px rgb(20 40 34 / 0.42);
			}

			.word { display: inline-flex; flex-wrap: wrap; max-width: 100%; }

			.char {
				display: inline-block;
				animation: char-in 1.05s var(--spring) backwards;
				animation-delay: calc(var(--i) * 52ms + 120ms);
			}

			@keyframes char-in {
				from {
					opacity: 0;
					transform: translate3d(0, 0.34em, 0);
					filter: blur(10px);
				}
				to { opacity: 1; transform: none; filter: none; }
			}

			.display-sub {
				margin: 1.1rem 0 0;
				font-size: clamp(0.95rem, 1.5vw, 1.2rem);
				font-style: italic;
				letter-spacing: 0.01em;
				color: rgb(255 255 255 / 0.92);
				text-shadow: 0 1px 2px rgb(20 40 34 / 0.4), 0 6px 24px rgb(20 40 34 / 0.4);
				animation: fade-up 1s var(--ease-out) 0.65s backwards;
			}

			.hero-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.hero-count,
			.scroll-cue {
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				animation: fade-up 1s var(--ease-out) 0.85s backwards;
			}

			.scroll-cue {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				text-decoration: none;
				color: var(--ink);
			}

			.scroll-cue :global(svg) {
				font-size: 0.9rem;
				animation: nudge 2.2s var(--ease-out) infinite;
			}

			@keyframes nudge {
				0%, 100% { transform: translateY(0); opacity: 0.55; }
				50% { transform: translateY(4px); opacity: 1; }
			}

			/* ── 内容区 ─────────────────────────────────────────── */
			.sheet {
				position: relative;
				/* 文章不足一屏时，底色要一直铺到页脚，不能让固定壁纸从中间透出来 */
				min-height: 60vh;
				padding: 0 var(--gutter) clamp(3rem, 8vw, 6rem);
				/* 顶部一段渐变把插画收进纸色，往下彻底交给纸色；
				   随内容滚动，卡片区域始终有稳定的依托 */
				background: linear-gradient(
					to bottom,
					transparent 0,
					color-mix(in oklch, var(--ground) 88%, transparent) 90px,
					var(--ground) 220px
				);
			}

			.sheet-inner {
				max-width: var(--page-max);
				margin: 0 auto;
			}

			.sheet-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.search {
				position: relative;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				min-width: min(100%, 18rem);
				padding: 0.5rem 0.9rem;
				border-radius: 999px;
				background: var(--card);
				box-shadow: var(--lift-1);
				transition: box-shadow 0.3s var(--ease-out);
			}

			.search:focus-within { box-shadow: var(--lift-2); }

			.search-icon { color: var(--ink-mute); flex-shrink: 0; }

			.search input {
				flex: 1;
				min-width: 0;
				border: 0;
				background: none;
				color: var(--ink);
				font-family: inherit;
				font-size: 0.9rem;
				outline: none;
			}

			.search input::placeholder { color: var(--ink-mute); }

			/* 去掉 Safari/Chrome 给 type=search 加的原生清除按钮，用自己的 */
			.search input::-webkit-search-cancel-button { display: none; }

			/* [hidden] 的 display:none 来自 UA 样式，会被这里的 display:grid 盖掉，
			   得显式让它失效 */
			.search button[hidden] { display: none; }

			.search button {
				display: grid;
				place-items: center;
				width: 1.4rem;
				height: 1.4rem;
				border: 0;
				border-radius: 50%;
				background: var(--accent-wash);
				color: var(--accent-deep);
				cursor: pointer;
				font-size: 0.8rem;
			}

			.search-summary {
				margin: 0 0 1.25rem;
			}

			.search-empty {
				padding: 3rem 1rem;
				text-align: center;
				color: var(--ink-soft);
			}

			/* ── 分页 ───────────────────────────────────────────── */
			.pager {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				margin-top: clamp(2rem, 5vw, 3rem);
			}

			.pager-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.6rem 1.1rem;
				border-radius: 999px;
				background: var(--card);
				box-shadow: var(--lift-1);
				color: var(--ink);
				font-size: 0.85rem;
				text-decoration: none;
				transition:
					transform 0.4s var(--spring),
					box-shadow 0.4s var(--ease-out),
					background-color 0.3s var(--ease-out),
					color 0.3s var(--ease-out);
			}

			.pager-btn:hover:not(.is-disabled) {
				background: var(--accent);
				color: #fff;
				transform: translateY(-2px);
				box-shadow: var(--lift-2);
			}

			.pager-btn.is-disabled {
				opacity: 0.4;
				box-shadow: none;
				pointer-events: none;
			}

			.pager-now { font-variant-numeric: tabular-nums; }

			.sheet-title {
				margin: 0;
				font-size: clamp(1.4rem, 2.6vw, 2rem);
				font-weight: 700;
				letter-spacing: -0.025em;
			}

			/* ── 特稿位 ─────────────────────────────────────────── */
			.feature {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				overflow: hidden;
				margin-bottom: 1.25rem;
				color: inherit;
				text-decoration: none;
			}

			.feature-art {
				min-height: 340px;
				background-size: cover;
				background-position: center;
				transition: transform 0.9s var(--ease-out);
			}

			.feature-body {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				padding: clamp(1.5rem, 3vw, 2.75rem);
			}

			.feature-kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--accent-deep);
			}

			.dot {
				width: 0.4rem;
				height: 0.4rem;
				border-radius: 50%;
				background: var(--accent);
			}

			.feature-title {
				margin: 0;
				font-size: clamp(1.5rem, 2.8vw, 2.35rem);
				font-weight: 700;
				line-height: 1.16;
				letter-spacing: -0.028em;
				text-wrap: balance;
			}

			.feature-desc {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.75;
				color: var(--ink-soft);
				text-wrap: pretty;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
			}

			.feature-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: auto;
				padding-top: 1rem;
				border-top: 1px solid var(--hair);
			}

			.feature-go {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: var(--accent-deep);
			}

			.feature-go :global(svg) { transition: transform 0.5s var(--spring); }

			/* ── 悬停 ───────────────────────────────────────────── */

			/* ── 滚动进场 ───────────────────────────────────────── */
			@media (prefers-reduced-motion: no-preference) {
				[data-reveal] {
					opacity: 0;
					transform: translate3d(0, 18px, 0);
					transition:
						opacity 0.65s var(--ease-out),
						transform 0.65s var(--spring);
					transition-delay: var(--reveal-delay, 0ms);
				}
				[data-reveal].is-in { opacity: 1; transform: none; }
			}

			/* ── 页脚 ───────────────────────────────────────────── */
			.footer {
				position: relative;
				padding: 2rem var(--gutter) 2.5rem;
				border-top: 1px solid var(--hair);
				/* 壁纸是 fixed 的，页脚不铺底色的话插画会从背后透上来 */
				background: var(--ground);
			}

			.footer-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				max-width: var(--page-max);
				margin: 0 auto;
			}

			.footer-back {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--ink-soft);
				text-decoration: none;
				transition: color 0.3s var(--ease-out);
			}

			.footer-back:hover { color: var(--accent-deep); }

			/* ── 响应式 ─────────────────────────────────────────── */
			@media (max-width: 900px) {
				.feature { grid-template-columns: 1fr; }
				.feature-art { min-height: 200px; aspect-ratio: 16 / 9; }
			}

			@media (max-width: 640px) {
				.display { font-size: clamp(2.2rem, 12vw, 4rem); }
				.hero-foot { flex-direction: column; align-items: stretch; }
				.hero-count { text-align: center; }
				.scroll-cue { justify-content: center; }
			}
		</style>

		<!-- 搜索索引：跨全部文章，不受当前分页限制 -->
		<script id="search-index" type="application/json" set:html={JSON.stringify(searchIndex)} is:inline />

		<script>
			// ── 标题 / 标签 搜索 ──────────────────────────────────
			// 纯前端过滤：索引已随页面内联，输入即出结果，不发请求。
			type Entry = {
				t: string; // 标题
				g: string[]; // 标签
				c: string; // 分类
				u: string; // 链接
				d: string; // 日期
				i: string; // 封面
				h: number; // 派生色相
			};

			const indexEl = document.getElementById("search-index");
			const entries: Entry[] = indexEl ? JSON.parse(indexEl.textContent || "[]") : [];

			const input = document.getElementById("search-input") as HTMLInputElement | null;
			const clearBtn = document.getElementById("search-clear") as HTMLButtonElement | null;
			const browse = document.getElementById("browse");
			const results = document.getElementById("search-results");
			const grid = document.getElementById("search-grid");
			const summary = document.getElementById("search-summary");

			function escapeHtml(v: string): string {
				return v.replace(/[&<>"']/g, (c) => ({
					"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
				})[c] as string);
			}

			function tileHtml(e: Entry, n: number): string {
				const art = e.i
					? `<div class="tile-art" style="background-image:url('${escapeHtml(e.i)}')">
							<span class="tile-num micro">${String(n).padStart(2, "0")}</span>
						</div>`
					: `<div class="tile-plate">
							<span class="tile-num-plain">${String(n).padStart(2, "0")}</span>
						</div>`;
				return `<a class="tile card ${e.i ? "has-art" : "no-art"}" href="${escapeHtml(e.u)}">
					${art}
					<div class="tile-body">
						<span class="micro tile-cat">${escapeHtml(e.c)}</span>
						<h3 class="tile-title">${escapeHtml(e.t)}</h3>
						<div class="tile-foot micro">
							<span>${escapeHtml(e.d.replace(/-/g, "/"))}</span>
						</div>
					</div>
				</a>`;
			}

			function run(raw: string): void {
				const q = raw.trim().toLowerCase();
				if (!clearBtn || !browse || !results || !grid || !summary) return;

				clearBtn.hidden = q.length === 0;

				if (!q) {
					results.hidden = true;
					browse.hidden = false;
					return;
				}

				// 空格分词，每个词都要命中（标题或任一标签或分类）
				const terms = q.split(/\s+/).filter(Boolean);
				const hits = entries.filter((e) => {
					const hay = `${e.t} ${e.g.join(" ")} ${e.c}`.toLowerCase();
					return terms.every((term) => hay.includes(term));
				});

				browse.hidden = true;
				results.hidden = false;
				summary.textContent = `“${raw.trim()}” — ${hits.length} 篇`;
				grid.innerHTML = hits.length
					? hits.map((e, i) => tileHtml(e, i + 1)).join("")
					: `<p class="search-empty">没有匹配的文章</p>`;
			}

			// 支持 ?q= 直接进入搜索状态，搜索结果因此可以分享
			const initialQuery = new URLSearchParams(location.search).get("q") ?? "";
			if (initialQuery && input) {
				input.value = initialQuery;
				run(initialQuery);
			}

			let debounce: number | undefined;
			function syncUrl(q: string): void {
				const url = new URL(location.href);
				if (q.trim()) url.searchParams.set("q", q.trim());
				else url.searchParams.delete("q");
				history.replaceState(null, "", url);
			}

			input?.addEventListener("input", () => {
				window.clearTimeout(debounce);
				debounce = window.setTimeout(() => {
					run(input.value);
					syncUrl(input.value);
				}, 120);
			});

			input?.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && input.value) {
					input.value = "";
					run("");
					syncUrl("");
				}
			});

			clearBtn?.addEventListener("click", () => {
				if (!input) return;
				input.value = "";
				run("");
				syncUrl("");
				input.focus();
			});
		</script>

		<script>
			// 滚动进场：同一批进入视口的卡片依次亮相，批次之间重新计数，
			// 否则滚到页面深处时延迟会累积成肉眼可见的卡顿
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

			if (reduce || !("IntersectionObserver" in window)) {
				for (const el of targets) el.classList.add("is-in");
			} else {
				let batch = 0;
				let timer: number | undefined;
				const io = new IntersectionObserver(
					(entries, obs) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							const el = e.target as HTMLElement;
							el.style.setProperty("--reveal-delay", `${Math.min(batch, 5) * 65}ms`);
							el.classList.add("is-in");
							obs.unobserve(el);
							batch++;
							window.clearTimeout(timer);
							timer = window.setTimeout(() => { batch = 0; }, 160);
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
				);
				for (const el of targets) io.observe(el);
			}

			document.getElementById("theme-toggle")?.addEventListener("click", () => {
				const dark = document.documentElement.classList.toggle("dark");
				// 代码块配色跟着一起切
				document.documentElement.setAttribute(
					"data-theme",
					dark ? "one-dark-pro" : "one-light",
				);
				try {
					localStorage.setItem("theme", dark ? "dark" : "light");
				} catch (e) {
					/* 隐私模式下忽略 */
				}
			});
		</script>
	</body>
</html>
