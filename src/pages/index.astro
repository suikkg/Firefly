---
// ─────────────────────────────────────────────────────────────────────────
// 概念稿 · 首页 v2
// v1 把站点改成了黑白编辑部风，等于删掉了这个站最强的三样东西：
// 插画、浅色薄荷调、浮在壁纸上的白色圆角卡片。
// v2 保留这套底子，加法做在排版精度、编排层次和动效上。
// ─────────────────────────────────────────────────────────────────────────
import { Icon } from "astro-icon/components";
import LabHead from "@/components/lab/LabHead.astro";
import { backgroundWallpaper, siteConfig } from "@/config";
import { getSortedPostsList } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";
import "@/styles/lab.css";

const posts = await getSortedPostsList();

const homeText = backgroundWallpaper.common?.homeText;
const displayTitle = homeText?.title || siteConfig.title || "KK";
const displaySubtitle = siteConfig.subtitle || "";
const subtitles = Array.isArray(homeText?.subtitle)
	? homeText.subtitle
	: [homeText?.subtitle].filter(Boolean);

// 按词分组再拆字：换行只发生在词与词之间，不会把单词劈开
const titleTokens = displayTitle
	.split(/(\s+)/)
	.filter((w) => w.trim().length > 0)
	.map((word) => [...word]);
let charCursor = 0;

/** 壁纸可能是字符串、数组，或 { desktop, mobile, playerUrl } */
function pickWallpaper(): string {
	const src = backgroundWallpaper.src;
	if (!src) return "";
	const first = (v: string | string[] | undefined): string =>
		Array.isArray(v) ? (v[0] ?? "") : (v ?? "");
	if (typeof src === "string") return src;
	if (Array.isArray(src)) return first(src);
	return first(src.desktop);
}
const wallpaper = pickWallpaper();

function hueFromString(value: string): number {
	let hash = 0;
	for (let i = 0; i < value.length; i++) {
		hash = (hash << 5) - hash + value.charCodeAt(i);
		hash |= 0;
	}
	return Math.abs(hash) % 360;
}

function usableImage(src: string): string {
	if (!src) return "";
	if (src.startsWith("http://") || src.startsWith("https://")) return src;
	if (src.startsWith("/")) return src;
	return "";
}

const items = posts.map((post, index) => ({
	index,
	title: post.data.title,
	postUrl: `/posts/${post.id}/`,
	realUrl: getPostUrlBySlug(post.id),
	category: post.data.category || "未分类",
	tags: post.data.tags.slice(0, 4),
	description: post.data.description,
	published: post.data.published,
	image: usableImage(post.data.image),
	hue: hueFromString(post.data.title),
}));

// 第一篇做特稿位，其余走紧凑列
const [feature, ...rest] = items;

const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
---

<html lang="zh-CN">
	<head>
		<LabHead />
		{wallpaper && <link rel="preload" as="image" href={wallpaper} fetchpriority="high" />}
	</head>

	<body>
		<!-- 壁纸固定在最底层，内容区半透明浮在上面 —— 和现有主题的 overlay 模式同源 -->
		<div class="wallpaper" style={`--wallpaper:url("${wallpaper}")`} aria-hidden="true"></div>

		<header class="hero">
			<div class="hero-bar">
				<nav class="hero-nav">
					<span class="hero-brand">
						<Icon is:inline name="lucide:sparkles" />
						{siteConfig.title}
					</span>
					<a href="/archive/">归档</a>
					<a href="/categories/">分类</a>
					<a href="/tags/">标签</a>
					<a href="/about/">关于</a>
				</nav>
				<div class="hero-actions">
					<a href="/classic/" class="circle-btn" aria-label="旧版界面" title="旧版界面">
						<Icon is:inline name="lucide:layout-panel-left" />
					</a>
					<button id="theme-toggle" class="circle-btn" type="button" aria-label="切换明暗">
						<Icon is:inline name="lucide:sun-moon" />
					</button>
				</div>
			</div>

			<div class="hero-center">
				<h1 class="display">
					{
						titleTokens.map((chars) => (
							<span class="word">
								{chars.map((char) => (
									<span class="char" style={`--i:${charCursor++}`}>
										{char}
									</span>
								))}
							</span>
						))
					}
				</h1>
				{subtitles[0] && <p class="display-sub">{subtitles[0]}</p>}
			</div>

			<div class="hero-foot">
				<span class="micro hero-count">{String(items.length).padStart(3, "0")} 篇文章</span>
				<a href="#index" class="scroll-cue" aria-label="向下滚动">
					<span class="micro">向下滚动</span>
					<Icon is:inline name="lucide:arrow-down" />
				</a>
			</div>
		</header>

		<main class="sheet" id="index">
			<div class="sheet-inner">
				<div class="sheet-head">
					<h2 class="sheet-title">文章</h2>
					<span class="micro">Index</span>
				</div>

				{
					feature && (
						<a class="feature card" href={feature.postUrl} data-reveal>
							<div
								class="feature-art"
								style={
									feature.image
										? `background-image:url("${feature.image}")`
										: `background-image:linear-gradient(145deg, oklch(0.82 0.11 ${feature.hue}), oklch(0.62 0.13 ${feature.hue + 40}))`
								}
							/>
							<div class="feature-body">
								<span class="micro feature-kicker">
									<span class="dot" />
									特稿 · {feature.category}
								</span>
								<h3 class="feature-title">{feature.title}</h3>
								{feature.description && <p class="feature-desc">{feature.description}</p>}
								<div class="feature-meta micro">
									<span>{dateFormatter.format(feature.published)}</span>
									<span class="feature-go">
										阅读 <Icon is:inline name="lucide:arrow-right" />
									</span>
								</div>
							</div>
						</a>
					)
				}

				<div class="grid">
					{
						rest.map((item) => (
							<a
								class:list={["tile", "card", item.image ? "has-art" : "no-art"]}
								href={item.postUrl}
								data-reveal
							>
								{item.image ? (
									<div class="tile-art" style={`background-image:url("${item.image}")`}>
										<span class="tile-num micro">{String(item.index + 1).padStart(2, "0")}</span>
									</div>
								) : (
									/* 没封面就不要拿假渐变块充数：给文字型卡片，
									   让网格在图文之间形成节奏，而不是一片糊墙纸 */
									<div class="tile-plate">
										<span class="tile-num-plain">{String(item.index + 1).padStart(2, "0")}</span>
									</div>
								)}
								<div class="tile-body">
									<span class="micro tile-cat">{item.category}</span>
									<h3 class="tile-title">{item.title}</h3>
									{!item.image && item.description && (
										<p class="tile-desc">{item.description}</p>
									)}
									<div class="tile-foot micro">
										<span>{dateFormatter.format(item.published)}</span>
										<Icon is:inline name="lucide:arrow-up-right" class="tile-arrow" />
									</div>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<span class="micro">{displaySubtitle}</span>
				<a href="/classic/" class="footer-back">
					<Icon is:inline name="lucide:layout-panel-left" />
					<span>切换到旧版界面</span>
				</a>
			</div>
		</footer>

		<style>
			/* ── 壁纸层 ─────────────────────────────────────────── */
			.wallpaper {
				position: fixed;
				inset: 0;
				z-index: -1;
				background-image: var(--wallpaper);
				background-size: cover;
				background-position: center 20%;
			}

			/* 注意：底纹不能挂在这个固定层上。挂在这里的话渐变是相对视口的，
			   一滚动，视口上半部分又变回全透明，卡片就直接压在原图上了。
			   正确做法是让底纹跟着内容一起滚——见 .sheet */

			/* ── Hero ───────────────────────────────────────────── */
			.hero {
				position: relative;
				z-index: 1;
				min-height: 100svh;
				display: grid;
				grid-template-rows: auto 1fr auto;
				gap: 2rem;
				padding: 1.5rem var(--gutter) 2.5rem;
			}

			.hero-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.hero-brand {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.5rem 1rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				font-size: 0.9rem;
				font-weight: 650;
				letter-spacing: -0.01em;
			}

			.hero-brand :global(svg) { color: var(--accent-deep); }

			.hero-nav {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				flex-wrap: wrap;
			}

			.hero-nav a {
				padding: 0.5rem 0.85rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				font-size: 0.82rem;
				color: var(--ink);
				text-decoration: none;
				transition:
					background-color 0.3s var(--ease-out),
					color 0.3s var(--ease-out);
			}

			.hero-nav a:hover {
				background: var(--accent);
				color: #fff;
			}

			.hero-actions { display: flex; gap: 0.6rem; }

			.hero-center {
				align-self: center;
				text-align: center;
			}

			/* 大标题压在插画上，用两层阴影保清晰：近处一层实的收边缘，
			   远处一层虚的把字从繁杂画面里托起来 */
			.display {
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0 0.26em;
				font-size: clamp(2.6rem, 8.5vw, 7.5rem);
				font-weight: 800;
				line-height: 0.98;
				letter-spacing: -0.035em;
				color: #fff;
				text-shadow:
					0 1px 2px rgb(20 40 34 / 0.34),
					0 10px 40px rgb(20 40 34 / 0.42);
			}

			.word { display: inline-flex; flex-wrap: wrap; max-width: 100%; }

			.char {
				display: inline-block;
				animation: char-in 1.05s var(--spring) backwards;
				animation-delay: calc(var(--i) * 52ms + 120ms);
			}

			@keyframes char-in {
				from {
					opacity: 0;
					transform: translate3d(0, 0.34em, 0);
					filter: blur(10px);
				}
				to { opacity: 1; transform: none; filter: none; }
			}

			.display-sub {
				margin: 1.1rem 0 0;
				font-size: clamp(0.95rem, 1.5vw, 1.2rem);
				font-style: italic;
				letter-spacing: 0.01em;
				color: rgb(255 255 255 / 0.92);
				text-shadow: 0 1px 2px rgb(20 40 34 / 0.4), 0 6px 24px rgb(20 40 34 / 0.4);
				animation: fade-up 1s var(--ease-out) 0.65s backwards;
			}

			.hero-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
			}

			.hero-count,
			.scroll-cue {
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				background: var(--card-soft);
				backdrop-filter: blur(12px);
				box-shadow: var(--lift-1);
				animation: fade-up 1s var(--ease-out) 0.85s backwards;
			}

			.scroll-cue {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				text-decoration: none;
				color: var(--ink);
			}

			.scroll-cue :global(svg) {
				font-size: 0.9rem;
				animation: nudge 2.2s var(--ease-out) infinite;
			}

			@keyframes nudge {
				0%, 100% { transform: translateY(0); opacity: 0.55; }
				50% { transform: translateY(4px); opacity: 1; }
			}

			/* ── 内容区 ─────────────────────────────────────────── */
			.sheet {
				position: relative;
				padding: 0 var(--gutter) clamp(3rem, 8vw, 6rem);
				/* 顶部一段渐变把插画收进纸色，往下彻底交给纸色；
				   随内容滚动，卡片区域始终有稳定的依托 */
				background: linear-gradient(
					to bottom,
					transparent 0,
					color-mix(in oklch, var(--ground) 88%, transparent) 90px,
					var(--ground) 220px
				);
			}

			.sheet-inner {
				max-width: var(--page-max);
				margin: 0 auto;
			}

			.sheet-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}

			.sheet-title {
				margin: 0;
				font-size: clamp(1.4rem, 2.6vw, 2rem);
				font-weight: 700;
				letter-spacing: -0.025em;
			}

			/* ── 特稿位 ─────────────────────────────────────────── */
			.feature {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				overflow: hidden;
				margin-bottom: 1.25rem;
				color: inherit;
				text-decoration: none;
			}

			.feature-art {
				min-height: 340px;
				background-size: cover;
				background-position: center;
				transition: transform 0.9s var(--ease-out);
			}

			.feature-body {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				padding: clamp(1.5rem, 3vw, 2.75rem);
			}

			.feature-kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--accent-deep);
			}

			.dot {
				width: 0.4rem;
				height: 0.4rem;
				border-radius: 50%;
				background: var(--accent);
			}

			.feature-title {
				margin: 0;
				font-size: clamp(1.5rem, 2.8vw, 2.35rem);
				font-weight: 700;
				line-height: 1.16;
				letter-spacing: -0.028em;
				text-wrap: balance;
			}

			.feature-desc {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.75;
				color: var(--ink-soft);
				text-wrap: pretty;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
			}

			.feature-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-top: auto;
				padding-top: 1rem;
				border-top: 1px solid var(--hair);
			}

			.feature-go {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				color: var(--accent-deep);
			}

			.feature-go :global(svg) { transition: transform 0.5s var(--spring); }

			/* ── 网格 ───────────────────────────────────────────── */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
				gap: 1.25rem;
			}

			.tile {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				color: inherit;
				text-decoration: none;
			}

			.tile-art {
				position: relative;
				aspect-ratio: 16 / 10;
				background-size: cover;
				background-position: center;
				transition: transform 0.9s var(--ease-out);
			}

			/* 编号压在图上，是 v1 那套索引编排里唯一值得留下的东西 */
			.tile-num {
				position: absolute;
				left: 0.75rem;
				bottom: 0.75rem;
				padding: 0.25rem 0.55rem;
				border-radius: 999px;
				background: rgb(255 255 255 / 0.86);
				backdrop-filter: blur(8px);
				color: var(--ink);
				letter-spacing: 0.1em;
			}

			/* 文字型卡片：用一条强调色顶边 + 大号编号占位，
			   视觉重量和图片卡持平，但气质完全不同 */
			.tile-plate {
				display: flex;
				align-items: flex-end;
				padding: 1rem 1.1rem 0;
				border-top: 3px solid var(--accent);
				background: linear-gradient(
					to bottom,
					var(--accent-wash),
					transparent
				);
			}

			.tile-num-plain {
				font-family: var(--mono);
				font-size: 2.1rem;
				font-weight: 500;
				line-height: 1;
				letter-spacing: -0.02em;
				color: var(--accent-deep);
				opacity: 0.75;
			}

			.tile-desc {
				margin: 0;
				font-size: 0.84rem;
				line-height: 1.7;
				color: var(--ink-soft);
				text-wrap: pretty;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
			}

			.tile-body {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				flex: 1;
				padding: 1rem 1.1rem 1.1rem;
			}

			.tile-cat { color: var(--accent-deep); }

			.tile-title {
				margin: 0;
				font-size: 1.05rem;
				font-weight: 650;
				line-height: 1.35;
				letter-spacing: -0.015em;
				text-wrap: pretty;
				display: -webkit-box;
				-webkit-box-orient: vertical;
				-webkit-line-clamp: 3;
				overflow: hidden;
			}

			.tile-foot {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.75rem;
				margin-top: auto;
				padding-top: 0.75rem;
				border-top: 1px solid var(--hair);
			}

			.tile-arrow {
				font-size: 0.95rem;
				color: var(--accent-deep);
				opacity: 0;
				transform: translate3d(-0.3rem, 0.3rem, 0);
				transition:
					opacity 0.4s var(--ease-out),
					transform 0.5s var(--spring);
			}

			/* ── 悬停 ───────────────────────────────────────────── */
			@media (hover: hover) and (prefers-reduced-motion: no-preference) {
				.feature:hover,
				.tile:hover {
					transform: translateY(-4px);
					box-shadow: var(--lift-3);
				}
				.feature:hover .feature-art,
				.tile:hover .tile-art { transform: scale(1.045); }
				.feature:hover .feature-go :global(svg) { transform: translateX(0.3rem); }
				.tile:hover .tile-arrow { opacity: 1; transform: none; }
			}

			/* ── 滚动进场 ───────────────────────────────────────── */
			@media (prefers-reduced-motion: no-preference) {
				[data-reveal] {
					opacity: 0;
					transform: translate3d(0, 18px, 0);
					transition:
						opacity 0.65s var(--ease-out),
						transform 0.65s var(--spring);
					transition-delay: var(--reveal-delay, 0ms);
				}
				[data-reveal].is-in { opacity: 1; transform: none; }
			}

			/* ── 页脚 ───────────────────────────────────────────── */
			.footer {
				padding: 2rem var(--gutter) 2.5rem;
				border-top: 1px solid var(--hair);
			}

			.footer-inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				max-width: var(--page-max);
				margin: 0 auto;
			}

			.footer-back {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.85rem;
				color: var(--ink-soft);
				text-decoration: none;
				transition: color 0.3s var(--ease-out);
			}

			.footer-back:hover { color: var(--accent-deep); }

			/* ── 响应式 ─────────────────────────────────────────── */
			@media (max-width: 900px) {
				.feature { grid-template-columns: 1fr; }
				.feature-art { min-height: 200px; aspect-ratio: 16 / 9; }
			}

			@media (max-width: 640px) {
				.display { font-size: clamp(2.2rem, 12vw, 4rem); }
				.hero-foot { flex-direction: column; align-items: stretch; }
				.hero-count { text-align: center; }
				.scroll-cue { justify-content: center; }
			}
		</style>

		<script>
			// 滚动进场：同一批进入视口的卡片依次亮相，批次之间重新计数，
			// 否则滚到页面深处时延迟会累积成肉眼可见的卡顿
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");

			if (reduce || !("IntersectionObserver" in window)) {
				for (const el of targets) el.classList.add("is-in");
			} else {
				let batch = 0;
				let timer: number | undefined;
				const io = new IntersectionObserver(
					(entries, obs) => {
						for (const e of entries) {
							if (!e.isIntersecting) continue;
							const el = e.target as HTMLElement;
							el.style.setProperty("--reveal-delay", `${Math.min(batch, 5) * 65}ms`);
							el.classList.add("is-in");
							obs.unobserve(el);
							batch++;
							window.clearTimeout(timer);
							timer = window.setTimeout(() => { batch = 0; }, 160);
						}
					},
					{ rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
				);
				for (const el of targets) io.observe(el);
			}

			document.getElementById("theme-toggle")?.addEventListener("click", () => {
				const dark = document.documentElement.classList.toggle("dark");
				// 代码块配色跟着一起切
				document.documentElement.setAttribute(
					"data-theme",
					dark ? "one-dark-pro" : "one-light",
				);
				try {
					localStorage.setItem("theme", dark ? "dark" : "light");
				} catch (e) {
					/* 隐私模式下忽略 */
				}
			});
		</script>
	</body>
</html>
