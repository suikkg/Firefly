---
// 打赏：方式来自 sponsorConfig
import { Icon } from "astro-icon/components";
import Comment from "@/components/comment/index.astro";
import { commentConfig, siteConfig, sponsorConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.sponsor) {
	return Astro.redirect("/404/");
}

const title = sponsorConfig.title || i18n(I18nKey.sponsor);
const description =
	sponsorConfig.description || i18n(I18nKey.sponsorDescription);

const methods = (sponsorConfig.methods || []).filter((m) => m.enabled);
const sponsors = sponsorConfig.showSponsorsList
	? sponsorConfig.sponsors || []
	: [];
const isCommentEnabled =
	!!commentConfig?.type &&
	commentConfig.type !== "none" &&
	sponsorConfig.showComment !== false;
---

<LabPage title={title} description={description} lede={description}>
	{
		sponsorConfig.usage && (
			<p class="usage">
				<Icon is:inline name="lucide:hand-heart" />
				<span>{sponsorConfig.usage}</span>
			</p>
		)
	}

	{
		methods.length === 0 ? (
			<p class="empty">暂未开启任何打赏方式</p>
		) : (
			<div class="methods">
				{methods.map((m) => {
					const Tag = m.link ? "a" : "div";
					return (
						<Tag
							class="method card"
							href={m.link || undefined}
							target={m.link ? "_blank" : undefined}
							rel={m.link ? "noopener noreferrer" : undefined}
						>
							<span class="method-icon">
								<Icon is:inline name={m.icon} />
							</span>
							<div class="method-body">
								<h2 class="method-name">{m.name}</h2>
								{m.description && <p class="method-desc">{m.description}</p>}
							</div>
							{m.qrCode ? (
								<img class="qr" src={url(m.qrCode)} alt={`${m.name} 收款码`} loading="lazy" />
							) : m.link ? (
								<Icon is:inline name="lucide:arrow-up-right" class="method-arrow" />
							) : null}
						</Tag>
					);
				})}
			</div>
		)
	}

	{
		sponsors.length > 0 && (
			<section class="list">
				<h2 class="list-title micro">感谢</h2>
				<ul class="sponsors">
					{sponsors.map((s: { name: string; amount?: string; date?: string }) => (
						<li>
							<span class="s-name">{s.name}</span>
							{s.amount && <span class="s-amount micro">{s.amount}</span>}
							{s.date && <span class="s-date micro">{s.date}</span>}
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		isCommentEnabled && (
			<section class="comments">
				<h2 class="comments-title micro">留言</h2>
				<Comment customPath="/sponsor" title={title} />
			</section>
		)
	}
</LabPage>

<style>
	.usage {
		display: flex; align-items: flex-start; gap: 0.6rem;
		max-width: var(--measure);
		margin: 0 0 1.75rem;
		font-size: 0.92rem; line-height: 1.75; color: var(--ink-soft);
		text-wrap: pretty;
	}
	.usage :global(svg) { margin-top: 0.3rem; flex-shrink: 0; color: var(--accent-deep); }

	.methods {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1rem;
	}

	.method {
		display: flex; align-items: center; gap: 0.9rem;
		padding: 1.1rem 1.15rem;
		color: inherit; text-decoration: none;
	}

	.method-icon {
		display: grid; place-items: center;
		width: 2.6rem; height: 2.6rem; flex-shrink: 0;
		border-radius: 50%;
		background: var(--accent-wash);
		color: var(--accent-deep);
		font-size: 1.25rem;
	}

	.method-body { min-width: 0; flex: 1; }
	.method-name { margin: 0; font-size: 1rem; font-weight: 650; letter-spacing: -0.015em; }
	.method-desc { margin: 0.2rem 0 0; font-size: 0.82rem; line-height: 1.55; color: var(--ink-soft); }

	.qr { width: 4.5rem; height: 4.5rem; flex-shrink: 0; border-radius: var(--radius-sm); object-fit: cover; }

	.method-arrow { flex-shrink: 0; color: var(--ink-mute); transition: transform 0.45s var(--spring), color 0.3s var(--ease-out); }

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		a.method:hover { transform: translateY(-3px); box-shadow: var(--lift-3); }
		a.method:hover .method-arrow { transform: translate(0.2rem, -0.2rem); color: var(--accent-deep); }
	}

	.list, .comments { margin-top: clamp(2.5rem, 6vw, 4rem); }

	.list-title, .comments-title {
		margin: 0 0 1.25rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--hair);
	}

	.sponsors { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; max-width: var(--measure); }

	.sponsors li {
		display: flex; align-items: baseline; gap: 0.8rem;
		padding: 0.7rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--card); box-shadow: var(--lift-1);
	}

	.s-name { font-weight: 600; font-size: 0.92rem; }
	.s-amount { color: var(--accent-deep); }
	.s-date { margin-left: auto; color: var(--ink-mute); }

	.comments :global(#post-comments) { max-width: var(--measure); }
	.comments :global(#post-comments > .absolute) { display: none; }

	.empty { padding: 3.5rem 1rem; text-align: center; color: var(--ink-soft); }
</style>
