---
import SitePage from "@/layouts/SitePage.astro";
import { getCategoryList } from "@/utils/content-utils";
const categories = await getCategoryList();
---
<SitePage title="主题" lede="按主题找到需要的笔记。"><nav class="pill-links" aria-label="文章主题">{categories.map(category => <a href={category.url}>{category.name}（{category.count}）</a>)}</nav><p><a href="/archive/">查看全部文章</a></p></SitePage>
