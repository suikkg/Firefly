---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Comment from "@/components/comment/index.astro";
import CodeGroupManager from "@/components/features/CodeGroupManager.astro";
import EncryptedPost from "@/components/features/EncryptedPost.astro";
import FancyboxManager from "@/components/features/FancyboxManager.astro";
import KatexManager from "@/components/features/KatexManager.astro";
import ReadingTools from "@/components/site/ReadingTools.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteHead from "@/components/site/SiteHead.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import { licenseConfig, profileConfig, siteConfig } from "@/config";
import { getRelatedPosts, getSortedPosts } from "@/utils/content-utils";
import { phyDictionarySeries } from "@/utils/post-series";
import { usableImage } from "@/utils/site-utils";
import "@rehype-callouts-theme";
import "@/styles/site.css";
import "@/styles/site-prose.css";
import "@/styles/diagrams.css";
import "@/styles/expressive-code.css";
export const getStaticPaths = (async () => {
	const posts = (await getSortedPosts()).sort(
		(a, b) => b.data.published.getTime() - a.data.published.getTime(),
	);
	return posts.map((entry, index) => {
		const seriesIndex = phyDictionarySeries.indexOf(entry.id);
		const prev =
			seriesIndex >= 0
				? posts.find((post) => post.id === phyDictionarySeries[seriesIndex - 1])
				: posts[index + 1];
		const next =
			seriesIndex >= 0
				? posts.find((post) => post.id === phyDictionarySeries[seriesIndex + 1])
				: posts[index - 1];
		return {
			params: { slug: entry.id },
			props: { entry, prev: prev ?? null, next: next ?? null },
		};
	});
}) satisfies GetStaticPaths;
const { entry, prev, next } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const minutes: number = remarkPluginFrontmatter?.minutes ?? 0;
const isEncrypted = !!entry.data.password;
const tocItems = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#+\s*$/, "").trim() }));
const related = await getRelatedPosts(entry, 3);
const cover = usableImage(entry.data.image);
---
<html lang={entry.data.lang || siteConfig.lang.replace("_", "-")}>
<head><SiteHead title={entry.data.title} description={entry.data.description || siteConfig.description} postSlug={entry.id} ogType="article" /><KatexManager /></head>
<body><div class="site-shell"><SiteHeader />
<div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
<main class="site-main reading-main" id="main-content" data-pagefind-body>
	<header class="article-heading">
		<div class="note-meta"><a href={`/archive/?category=${encodeURIComponent(entry.data.category || "未分类")}`}>{entry.data.category || "未分类"}</a><time datetime={entry.data.published.toISOString()}>{entry.data.published.toISOString().slice(0, 10)}</time>{entry.data.updated && <span>更新 {entry.data.updated.toISOString().slice(0, 10)}</span>}</div>
		<h1 data-pagefind-meta="title">{entry.data.title}</h1>
		{entry.data.description && <p class="standfirst" data-pagefind-meta="description">{entry.data.description}</p>}
		<div class="note-meta" data-pagefind-ignore>{isEncrypted ? <span class="lock-label">受保护笔记</span> : <span>约 {minutes} 分钟阅读</span>}{entry.data.tags.map(tag => <a href={`/archive/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div>
		{cover && <img class="post-cover" src={cover} alt="" width="780" height="440" decoding="async" />}
		<ReadingTools post={{ id: entry.id, title: entry.data.title }} protected={isEncrypted} />
	</header>
	<div class="reading-grid">
		<article class="prose site-prose" id="article" tabindex="-1" data-pagefind-ignore={isEncrypted ? "all" : undefined}>
			{isEncrypted ? <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}><Content /></EncryptedPost> : <Content />}
		</article>
		<details class="toc" id="toc" aria-label="文章目录" open hidden={isEncrypted || tocItems.length === 0} data-pagefind-ignore>
			<summary>文章目录</summary><ul>{!isEncrypted && tocItems.map(h => <li class={`toc-item depth-${h.depth}`}><a href={`#${h.slug}`} data-toc-link={h.slug}><span class="toc-text">{h.text}</span></a></li>)}</ul>
		</details>
	</div>
	<section class="article-end" data-pagefind-ignore>
		<nav class="reading-pager" aria-label={phyDictionarySeries.includes(entry.id) ? "字典系列前后篇" : "前后篇"}>{prev && <a href={`/posts/${prev.id}/`}><span>上一篇</span>{prev.data.title}</a>}{next && <a href={`/posts/${next.id}/`}><span>下一篇</span>{next.data.title}</a>}</nav>
		{licenseConfig.enable && <p class="license">作者：{entry.data.author || profileConfig.name} · <a href={entry.data.licenseUrl || licenseConfig.url}>{entry.data.licenseName || licenseConfig.name}</a>{entry.data.sourceLink && <> · <a href={entry.data.sourceLink}>原文来源</a></>}</p>}
		{related.length > 0 && <section class="related"><h2>继续阅读</h2><ul>{related.map(post => <li><a href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul></section>}
		{entry.data.comment && !isEncrypted && <Comment post={entry} />}
	</section>
</main><FancyboxManager /><CodeGroupManager /><SiteFooter /></div>
<style>
.progress { position: fixed; inset: 0 0 auto; height: 2px; z-index: 100; }.progress span { display: block; height: 100%; width: 0; background: var(--accent); }
.reading-main { max-width: var(--page-max); }
.article-heading { max-width: 780px; margin-bottom: 32px; }
.article-heading h1 { font-size: clamp(28px, 3.6vw, 42px); line-height: 1.4; letter-spacing: -0.025em; margin: 16px 0; }
.standfirst { font-size: 16px; line-height: 1.8; color: var(--ink-soft); margin-bottom: 20px; }
.post-cover { display: block; width: 100%; height: auto; max-height: 420px; object-fit: cover; margin-top: 24px; border-radius: 12px; }
.reading-grid { display: grid; grid-template-columns: minmax(0, 780px) minmax(0, 220px); gap: 48px; align-items: start; }
.toc { position: sticky; top: 24px; max-height: calc(100svh - 48px); overflow-y: auto; font-size: 13px; border-left: 1px solid var(--hair); padding-left: 16px; }
.toc summary { font-weight: 650; cursor: pointer; color: var(--ink); padding-block: 8px; }
.toc ul { list-style: none; padding: 0; margin: 8px 0; }.toc li { margin: 4px 0; }.toc a { color: var(--ink-soft); text-decoration: none; display: block; padding: 6px 0; line-height: 1.6; }.toc .depth-3 { padding-left: 12px; }.toc .is-active a { color: var(--accent); font-weight: 650; }
.article-end { max-width: 780px; margin-top: 40px; }.reading-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; border-top: 1px solid var(--hair); padding-block: 24px; }.reading-pager a { line-height: 1.7; text-decoration: none; }.reading-pager span { display: block; color: var(--ink-soft); font-size: 13px; margin-bottom: 8px; }
.license { font-size: 13px; color: var(--ink-soft); line-height: 1.8; }.related { margin-block: 32px; }.related h2 { font-size: 20px; }.related ul { padding-left: 20px; line-height: 2; }
@media (max-width: 1000px) { .reading-grid { display: flex; flex-direction: column; gap: 24px; }.toc { order: -1; position: static; width: 100%; max-height: 320px; background: var(--card); border: 1px solid var(--hair); border-radius: 8px; padding: 8px 16px; }.article-heading, .article-end { margin-inline: auto; }.reading-main { max-width: 780px; } }
@media (max-width: 600px) { .reading-pager { grid-template-columns: 1fr; }.standfirst { font-size: 14px; } }
</style>
		<script>
			// 阅读进度只计算正文区间。
			const bar = document.getElementById("progress-bar");
			const article = document.getElementById("article");

			let ticking = false;

			function onScroll(): void {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					if (bar && article) {
						// 进度按正文区间算，而不是整页 —— 读完最后一段就该是 100%
						const bounds = article.getBoundingClientRect();
						const start = bounds.top + window.scrollY;
						const span = bounds.height - window.innerHeight;
						const ratio =
							span > 0
								? (window.scrollY - start) / span
								: window.scrollY > start
									? 1
									: 0;
						bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
					}
					ticking = false;
				});
			}

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll);
			if (article && "ResizeObserver" in window) new ResizeObserver(onScroll).observe(article);
			onScroll();

			// ── 目录高亮 ──────────────────────────────────────────
			// 目录可能在运行时才出现（加密文章解锁后重建），所以观察器要能重挂
			let tocObserver: IntersectionObserver | null = null;

			function wireToc(): void {
				tocObserver?.disconnect();
				tocObserver = null;

				const links = new Map<string, HTMLElement>();
				for (const a of document.querySelectorAll<HTMLElement>("[data-toc-link]")) {
					const slug = a.dataset.tocLink;
					const item = a.closest<HTMLElement>(".toc-item");
					if (slug && item) links.set(slug, item);
				}

				const targets = [...links.keys()]
					.map((slug) => document.getElementById(slug))
					.filter((el): el is HTMLElement => el !== null);

				if (targets.length === 0 || !("IntersectionObserver" in window)) return;

				let active: string | null = null;

				tocObserver = new IntersectionObserver(
					(entries) => {
						// 取当前所有可见标题里最靠上的那个，避免多个同时命中时来回跳
						const visible = entries
							.filter((e) => e.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
						if (!visible) return;
						const id = visible.target.id;
						if (id === active) return;
						if (active) links.get(active)?.classList.remove("is-active");
						links.get(id)?.classList.add("is-active");
						active = id;
					},
					// 只认视口上部这一条带，读到哪一节就亮哪一节
					{ rootMargin: "-10% 0px -70% 0px", threshold: 0 },
				);

				for (const t of targets) tocObserver.observe(t);
			}

			wireToc();

			// ── 加密文章：解锁后从正文重建目录 ────────────────────
			// 正文是解密时才注入 DOM 的，SSR 阶段没有标题可用，只能在这里补
			function buildTocFromArticle(): void {
				const decrypted = document.getElementById("decrypted-content");
				if (decrypted && decrypted.dataset.decryptionComplete !== "true") return;
				const nav = document.getElementById("toc");
				const list = nav?.querySelector("ul");
				// 解密后的正文单独挂在 #decrypted-content 里；解锁面板留在 DOM 中，不能扫进来
				const root = document.getElementById("decrypted-content") ?? article;
				if (!nav || !list || !root) return;

				list.replaceChildren();
				let count = 0;

				for (const h of root.querySelectorAll<HTMLElement>("h2, h3")) {
					if (!h.id) continue;

					const item = document.createElement("li");
					item.className = `toc-item depth-${h.tagName === "H2" ? 2 : 3}`;

					const link = document.createElement("a");
					link.href = `#${h.id}`;
					link.dataset.tocLink = h.id;

					const text = document.createElement("span");
					text.className = "toc-text";
					// autolink-headings 会把锚点的 "#" 并进标题文本，这里去掉
					text.textContent = (h.textContent ?? "").replace(/#+\s*$/, "").trim();

					link.append(text);
					item.append(link);
					list.append(item);
					count++;
				}

				nav.hidden = count === 0;

				wireToc();
				// 正文高度刚从解锁面板变成整篇文章，进度条得重算
				onScroll();
			}

			document.addEventListener("password:decrypted", buildTocFromArticle);
			if (document.getElementById("decrypted-content")?.dataset.decryptionComplete === "true") buildTocFromArticle();

		</script><script>
 const toc = document.getElementById("toc") as HTMLDetailsElement | null;
 if (toc && matchMedia("(max-width: 1000px)").matches) toc.open = false;
 document.addEventListener("keydown", event => { if (event.key === "Escape" && toc?.open && matchMedia("(max-width: 1000px)").matches) { toc.open = false; toc.querySelector("summary")?.focus(); } });
 toc?.addEventListener("click", event => { if ((event.target as HTMLElement).closest("a") && matchMedia("(max-width: 1000px)").matches) toc.open = false; });
</script></body></html>
