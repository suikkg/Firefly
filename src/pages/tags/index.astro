---
// 标签云：字号随文章数变化，点进去落到 /archive/?tag=…
import LabPage from "@/layouts/LabPage.astro";
import { getTagList } from "@/utils/content-utils";
import { getTagUrl } from "@/utils/url-utils";

const tags = await getTagList();
const total = tags.reduce((sum, t) => sum + t.count, 0);
const max = Math.max(1, ...tags.map((t) => t.count));
const min = Math.min(...tags.map((t) => t.count), 1);

/** 把文章数映射到 0–1，用于插值字号与颜色深浅 */
function weight(count: number): number {
	if (max === min) return 0.5;
	return (count - min) / (max - min);
}
---

<LabPage title="标签" lede={`${tags.length} 个标签，共 ${total} 次使用。字号代表文章数量。`}>
	{
		tags.length === 0 ? (
			<p class="empty">还没有任何标签</p>
		) : (
			<div class="cloud">
				{tags.map((t) => (
					<a class="tag" href={getTagUrl(t.name)} style={`--w:${weight(t.count)}`}>
						<span class="hash">#</span>
						<span class="name">{t.name}</span>
						<span class="count">{t.count}</span>
					</a>
				))}
			</div>
		)
	}
</LabPage>

<style>
	.cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		background: var(--card);
		border-radius: var(--radius);
		box-shadow: var(--lift-1);
	}

	.tag {
		display: inline-flex;
		align-items: baseline;
		gap: 0.3rem;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--accent) calc(6% + var(--w) * 10%), var(--card));
		color: var(--ink);
		text-decoration: none;
		/* 字号在 0.85rem 与 1.45rem 之间按文章数插值 */
		font-size: calc(0.85rem + var(--w) * 0.6rem);
		font-weight: calc(500 + var(--w) * 200);
		letter-spacing: -0.01em;
		line-height: 1.3;
		transition:
			background-color 0.3s var(--ease-out),
			color 0.3s var(--ease-out),
			transform 0.45s var(--spring);
	}

	.hash { color: var(--accent-deep); font-weight: 500; }

	.count {
		font-family: var(--mono);
		font-size: 0.68em;
		color: var(--ink-mute);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.tag:hover {
			background: var(--accent);
			color: #fff;
			transform: translateY(-2px);
		}
		.tag:hover .hash,
		.tag:hover .count { color: rgb(255 255 255 / 0.8); }
	}

	.empty {
		padding: 4rem 1rem;
		text-align: center;
		color: var(--ink-soft);
	}
</style>
