---
// 搜索：全文检索走 Pagefind（构建期生成索引），
// 标题/标签的即时过滤走内联索引，两者互补。
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SitePage from "@/layouts/SitePage.astro";
import { getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const posts = await getSortedPostsList();
const index = posts.map((p) => ({
	t: p.data.title,
	g: p.data.tags,
	c: p.data.category || "未分类",
	u: `/posts/${p.id}/`,
	d: p.data.published.toISOString().slice(0, 10),
}));

const title = i18n(I18nKey.search);
---
<SitePage title={title} description="搜索文章标题、标签与公开正文" lede="标题、标签与公开正文都可检索；受保护笔记仅匹配公开信息。">
 <div class="box" role="search"><Icon name="lucide:search" /><input id="q" type="search" placeholder="输入关键词…" aria-label="搜索笔记" autocomplete="off" /><button id="clear" type="button" aria-label="清空" hidden><Icon name="lucide:x" /></button></div>
 <p class="hint" id="hint" role="status" aria-live="polite">输入关键词开始搜索。</p>
 <section class="block" id="quick-block" hidden><h2 class="block-title">标题与标签</h2><ul class="hits" id="quick"></ul></section>
 <section class="block" id="full-block" hidden><h2 class="block-title">公开正文</h2><ul class="hits" id="full"></ul></section>
 <p class="pf-note" id="pf-note" role="status" hidden></p><button id="retry-search" type="button" hidden>重试全文检索</button>
</SitePage>
<script id="quick-index" type="application/json" data-pagefind-url={url("/pagefind/pagefind.js")} set:html={JSON.stringify(index).replaceAll("<", "\\u003c")} is:inline />
<style>
	.box {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.85rem 1.15rem;
		border: 1px solid var(--hair);
		border-radius: var(--radius);
		background: var(--card);
		box-shadow: var(--lift-1);
		transition: box-shadow 0.3s var(--ease-out);
	}

	.box:focus-within { outline: 2px solid var(--accent); outline-offset: 3px; }
	.box-icon { color: var(--ink-mute); flex-shrink: 0; }

	.box input {
		flex: 1;
		min-width: 0;
		border: 0;
		background: none;
		color: var(--ink);
		font-family: inherit;
		font-size: 1rem;
		outline: none;
	}

	.box input::placeholder { color: var(--ink-mute); }
	.box input::-webkit-search-cancel-button { display: none; }

	.box button[hidden] { display: none; }

	.box button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border: 0;
		border-radius: 50%;
		background: var(--accent-wash);
		color: var(--accent-deep);
		cursor: pointer;
		font-size: 0.85rem;
	}

	.hint,
	.pf-note {
		padding: 2.5rem 1rem;
		text-align: center;
		color: var(--ink-soft);
	}

	.hint[hidden],
	.pf-note[hidden],
	.block[hidden] { display: none; }

	.block { margin-top: 2rem; }

	.block-title {
		margin: 0 0 0.9rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--hair);
	}

	.hits {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}

	.hits :global(a) {
		display: block;
		padding: 0.9rem 1.15rem;
		border-radius: var(--radius-sm);
		background: var(--card);
		box-shadow: var(--lift-1);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.4s var(--spring),
			box-shadow 0.4s var(--ease-out);
	}

	.hits :global(a:hover) {
		transform: translateY(-2px);
		box-shadow: var(--lift-2);
	}

	.hits :global(.h-title) {
		font-size: 0.98rem;
		font-weight: 650;
		letter-spacing: -0.012em;
	}

	.hits :global(.h-meta) {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.3rem;
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		color: var(--ink-mute);
	}

	.hits :global(.h-excerpt) {
		margin: 0.4rem 0 0;
		font-size: 0.85rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.hits :global(mark) {
		background: var(--accent-wash);
		color: var(--accent-deep);
		border-radius: 3px;
		padding: 0 0.15em;
	}
</style>
<script>
 type Entry = { t: string; g: string[]; c: string; u: string; d: string };
 type SearchData = { url: string; meta: { title?: string }; excerpt: string };
 type Pagefind = { options: (options: { excerptLength: number }) => Promise<void>; search: (query: string) => Promise<{ results: { data: () => Promise<SearchData> }[] }> };
 const indexEl = document.getElementById("quick-index");
 const entries: Entry[] = JSON.parse(indexEl?.textContent || "[]");
 const input = document.getElementById("q") as HTMLInputElement;
 const clear = document.getElementById("clear") as HTMLButtonElement;
 const hint = document.getElementById("hint")!;
 const quickBlock = document.getElementById("quick-block")!;
 const fullBlock = document.getElementById("full-block")!;
 const quick = document.getElementById("quick")!;
 const full = document.getElementById("full")!;
 const note = document.getElementById("pf-note")!;
 const retry = document.getElementById("retry-search")!;
 let generation = 0;
 let timer: number | undefined;
 let ready: Promise<Pagefind> | undefined;
	let attempts = 0;
 function loadIndex(): Promise<Pagefind> {
  if (!ready) ready = (async () => {
   if (import.meta.env.DEV) throw new Error("development");
   const path = indexEl?.dataset.pagefindUrl || "/pagefind/pagefind.js";
   const pf = await import(/* @vite-ignore */ attempts++ ? `${path}?retry=${attempts}` : path) as Pagefind;
   await pf.options({ excerptLength: 24 });
   return pf;
  })();
  return ready;
 }
 function esc(value: string): string { return value.replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]!); }
 function excerptHtml(value: string): string {
  const body = new DOMParser().parseFromString(value, "text/html").body;
  function render(node: Node): string {
   if (node.nodeType === Node.TEXT_NODE) return esc(node.textContent || "");
   if (!(node instanceof Element) || ["SCRIPT", "STYLE", "IFRAME", "OBJECT", "EMBED"].includes(node.tagName)) return "";
   const content = Array.from(node.childNodes).map(render).join("");
   return node.tagName === "MARK" ? `<mark>${content}</mark>` : content;
  }
  return Array.from(body.childNodes).map(render).join("");
 }
 function row(href: string, title: string, metadata: string, excerpt = ""): string {
  return `<li><a href="${esc(href)}"><div class="h-title">${esc(title)}</div><div class="h-meta">${esc(metadata)}</div>${excerpt ? `<p class="h-excerpt">${excerptHtml(excerpt)}</p>` : ""}</a></li>`;
 }
 function syncUrl(query: string): void { const u = new URL(location.href); if (query) u.searchParams.set("q", query); else u.searchParams.delete("q"); history.replaceState(null, "", u); }
 async function run(): Promise<void> {
  const request = ++generation;
  const query = input.value.trim();
  syncUrl(query); clear.hidden = !query; fullBlock.hidden = true; note.hidden = true; retry.hidden = true; full.replaceChildren();
  if (!query) { quickBlock.hidden = true; quick.replaceChildren(); hint.hidden = false; hint.textContent = "输入关键词开始搜索。"; return; }
  const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
  const hits = entries.filter(entry => terms.every(term => `${entry.t} ${entry.g.join(" ")} ${entry.c}`.toLowerCase().includes(term)));
  quick.innerHTML = hits.map(entry => row(entry.u, entry.t, `${entry.c} · ${entry.d}`)).join(""); quickBlock.hidden = !hits.length;
  hint.hidden = false; hint.textContent = "正在检索公开正文…";
  try {
   const pf = await loadIndex();
   const search = await pf.search(query);
   const data = await Promise.all(search.results.slice(0, 30).map(result => result.data()));
   if (request !== generation) return;
   const seen = new Set(hits.map(hit => hit.u));
   const unique = data.filter(result => { const path = new URL(result.url, location.origin).pathname; if (!path.startsWith("/posts/") || seen.has(path)) return false; seen.add(path); return true; });
   full.innerHTML = unique.map(result => row(result.url, result.meta.title || result.url, "正文匹配", result.excerpt)).join("");
   fullBlock.hidden = !unique.length; hint.textContent = hits.length + unique.length ? `找到 ${hits.length + unique.length} 篇笔记。` : "没有匹配的笔记，试试其他关键词。";
  } catch {
   if (request !== generation) return;
   hint.textContent = hits.length ? `找到 ${hits.length} 篇标题或标签匹配的笔记。` : "标题与标签没有匹配的笔记。";
   note.hidden = false; note.textContent = import.meta.env.DEV ? "开发预览未生成全文索引；请在生产构建后验证全文检索。" : "全文检索暂不可用，仍可搜索标题与标签。"; retry.hidden = import.meta.env.DEV;
  }
 }
 input.addEventListener("input", () => { generation++; clearTimeout(timer); timer = window.setTimeout(run, 150); });
 function reset(): void { clearTimeout(timer); input.value = ""; void run(); input.focus(); }
 clear.addEventListener("click", reset);
 input.addEventListener("keydown", event => { if (event.key === "Escape") reset(); });
 retry.addEventListener("click", () => { ready = undefined; void run(); });
 input.value = new URLSearchParams(location.search).get("q") || "";
 input.focus({ preventScroll: true });
 void run();
</script>
