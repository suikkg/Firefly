---
import SitePage from "@/layouts/SitePage.astro";
import PostList from "@/components/site/PostList.astro";
import { getSortedPostsList } from "@/utils/content-utils";
const recent = (await getSortedPostsList())
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
	.slice(0, 6);
const feed = new URL("rss.xml", Astro.site).href;
---
<SitePage title="订阅更新" lede="将订阅地址加入阅读器，订阅新文章。受保护笔记仅提供公开简介。"><div class="feed-link"><a href={feed}>{feed}</a><button type="button" id="copy-feed" data-feed={feed}>复制订阅地址</button><span id="copy-state" role="status"></span></div><h2>最近更新</h2><PostList posts={recent} /></SitePage>
<script>
 const button = document.getElementById("copy-feed") as HTMLButtonElement;
 button?.addEventListener("click", async () => { const state = document.getElementById("copy-state"); try { await navigator.clipboard.writeText(button.dataset.feed || ""); if(state) state.textContent = "已复制"; } catch { if(state) state.textContent = "复制失败，请手动复制上方地址。"; } });
</script>
<style>.feed-link { display:flex; flex-wrap:wrap; align-items:center; gap:16px; margin-bottom:32px; padding:24px; background:var(--card); border:1px solid var(--hair); border-radius:12px; }.feed-link button { min-height:44px; padding:8px 16px; border:1px solid var(--hair); background:var(--accent-wash); color:var(--ink); border-radius:8px; }h2 { font-size:24px; }</style>
