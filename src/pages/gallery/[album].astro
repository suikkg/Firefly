---
// 相册详情：照片网格，点击走 Fancybox 灯箱（FancyboxManager 已绑定 .lab-gallery img）
import { Icon } from "astro-icon/components";
import EncryptedContent from "@/components/features/EncryptedContent.astro";
import FancyboxManager from "@/components/features/FancyboxManager.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
import { scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

export function getStaticPaths() {
	return galleryConfig.albums.map((album) => ({ params: { album: album.id } }));
}

const { album: albumId } = Astro.params;
const albumMeta = galleryConfig.albums.find((a) => a.id === albumId);
if (!albumMeta) {
	return Astro.redirect("/404/");
}

const photos = scanAlbumPhotos(albumMeta.id);
const columnWidth = galleryConfig.columnWidth || 240;

const lede = [
	albumMeta.description,
	albumMeta.location,
	albumMeta.date,
	`${photos.length} 张`,
]
	.filter(Boolean)
	.join(" · ");
---

<LabPage title={albumMeta.name} description={albumMeta.description || ""} lede={lede}>
	<a class="back" href={url("/gallery/")}>
		<Icon is:inline name="lucide:arrow-left" />
		<span>{i18n(I18nKey.galleryBackToAlbums)}</span>
	</a>

	{
		albumMeta.password ? (
			<EncryptedContent
				password={albumMeta.password}
				slug={`gallery-${albumMeta.id}`}
				hint={albumMeta.passwordHint}
			>
				<div class="grid lab-gallery" style={`--col:${columnWidth}px`}>
					{photos.map((p) => (
						<img src={url(p)} alt="" loading="lazy" decoding="async" />
					))}
				</div>
			</EncryptedContent>
		) : photos.length === 0 ? (
			<p class="empty">这个相册还没有照片</p>
		) : (
			<div class="grid lab-gallery" style={`--col:${columnWidth}px`}>
				{photos.map((p, i) => (
					<img src={url(p)} alt="" loading={i < 6 ? "eager" : "lazy"} decoding="async" />
				))}
			</div>
		)
	}

	<FancyboxManager />
</LabPage>

<style>
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
		padding: 0.5rem 0.95rem;
		border-radius: 999px;
		background: var(--card);
		box-shadow: var(--lift-1);
		color: var(--ink);
		font-size: 0.85rem;
		text-decoration: none;
		transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
	}

	.back:hover { background: var(--accent); color: #fff; }

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--col)), 1fr));
		gap: 0.75rem;
	}

	.grid :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border-radius: var(--radius-sm);
		background: var(--accent-wash);
		box-shadow: var(--lift-1);
		cursor: zoom-in;
		transition: transform 0.5s var(--spring), box-shadow 0.4s var(--ease-out);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.grid :global(img:hover) { transform: translateY(-3px) scale(1.01); box-shadow: var(--lift-3); }
	}

	/* 加密相册的解锁界面（组件用 Tailwind 写的，这里重画一遍） */
	:global(#password-ui) { display: flex; justify-content: center; padding: 3rem 0; }

	:global(#password-ui > div) {
		display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
		width: 100%; max-width: 24rem; padding: 2.25rem 2rem;
		border-radius: var(--radius); background: var(--card); box-shadow: var(--lift-1);
	}

	:global(#password-ui h2) { margin: 0.4rem 0 0; font-size: 1.1rem; font-weight: 650; }
	:global(#password-ui p) { margin: 0; font-size: 0.85rem; line-height: 1.6; text-align: center; color: var(--ink-soft); }
	:global(#password-ui svg) { width: 2.4rem; height: 2.4rem; color: var(--accent); }

	:global(#password-form) { display: flex; flex-direction: column; gap: 0.6rem; width: 100%; margin-top: 0.5rem; }

	:global(#password-input) {
		width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--hair);
		border-radius: var(--radius-sm); background: none; color: var(--ink);
		font-family: var(--mono); font-size: 0.85rem; outline: none;
	}
	:global(#password-input:focus) { border-color: var(--accent); }

	:global(#password-form button) {
		width: 100%; padding: 0.6rem 0.8rem; border: 1px solid var(--ink);
		border-radius: var(--radius-sm); background: var(--ink); color: var(--ground);
		font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.16em;
		text-transform: uppercase; cursor: pointer;
	}

	:global(#password-error) { font-size: 0.78rem; color: oklch(0.62 0.19 25); }
	:global(#password-error.hidden), :global(#decrypted-content.hidden) { display: none; }

	.empty { padding: 3.5rem 1rem; text-align: center; color: var(--ink-soft); }
</style>
