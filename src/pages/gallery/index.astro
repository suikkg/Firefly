---
// 相册总览：数据来自 galleryConfig + public/gallery 目录扫描
import { Icon } from "astro-icon/components";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	return {
		...album,
		cover: getAlbumCover(album, photos),
		photoCount: photos.length,
	};
});
const allTags = [...new Set(albums.flatMap((a) => a.tags || []))].sort();

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);
---

<LabPage title={title} description={description} lede={description}>
	{
		allTags.length > 0 && (
			<div class="filter" role="group" aria-label="按标签筛选">
				<button type="button" class="chip is-on" data-tag="">
					全部 <span class="chip-n">{albums.length}</span>
				</button>
				{allTags.map((t) => (
					<button type="button" class="chip" data-tag={t}>
						{t}
						<span class="chip-n">{albums.filter((a) => (a.tags || []).includes(t)).length}</span>
					</button>
				))}
			</div>
		)
	}

	{
		albums.length === 0 ? (
			<p class="empty">还没有创建相册</p>
		) : (
			<div class="albums">
				{albums.map((a) => (
					<a
						class="album card"
						href={url(`/gallery/${a.id}/`)}
						data-tags={JSON.stringify(a.tags || [])}
					>
						<div class="album-art" style={a.cover ? `background-image:url("${url(a.cover)}")` : ""}>
							{a.password && (
								<span class="lock" title="需要密码">
									<Icon is:inline name="lucide:lock-keyhole" />
								</span>
							)}
							<span class="count micro">{a.photoCount} 张</span>
						</div>
						<div class="album-body">
							<h2 class="album-name">{a.name}</h2>
							{a.description && <p class="album-desc">{a.description}</p>}
							<div class="album-meta micro">
								{a.date && <span>{a.date}</span>}
								{a.location && (
									<span class="loc">
										<Icon is:inline name="lucide:map-pin" /> {a.location}
									</span>
								)}
							</div>
						</div>
					</a>
				))}
			</div>
		)
	}

	<p class="empty" id="no-match" hidden>该标签下没有相册</p>
</LabPage>

<style>
	.chip[hidden], .empty[hidden], .album[hidden] { display: none; }

	.filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }

	.chip {
		display: inline-flex; align-items: center; gap: 0.4rem;
		padding: 0.45rem 0.9rem; border: 0; border-radius: 999px;
		background: var(--card); box-shadow: var(--lift-1); color: var(--ink);
		font-family: inherit; font-size: 0.82rem; cursor: pointer;
		transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out), transform 0.4s var(--spring);
	}
	.chip:hover { transform: translateY(-2px); }
	.chip.is-on { background: var(--accent); color: #fff; }
	.chip-n { font-family: var(--mono); font-size: 0.7em; opacity: 0.65; }

	.albums {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
		gap: 1.15rem;
	}

	.album { display: flex; flex-direction: column; overflow: hidden; color: inherit; text-decoration: none; }

	.album-art {
		position: relative;
		aspect-ratio: 4 / 3;
		background: var(--accent-wash) center / cover no-repeat;
		transition: transform 0.9s var(--ease-out);
	}

	.count, .lock {
		position: absolute;
		padding: 0.22rem 0.55rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.86);
		backdrop-filter: blur(8px);
		color: var(--ink);
	}
	.count { right: 0.7rem; bottom: 0.7rem; letter-spacing: 0.08em; }
	.lock { left: 0.7rem; top: 0.7rem; display: grid; place-items: center; padding: 0.35rem; }

	.album-body { display: flex; flex-direction: column; gap: 0.4rem; flex: 1; padding: 0.95rem 1.1rem 1.1rem; }

	.album-name { margin: 0; font-size: 1.05rem; font-weight: 650; letter-spacing: -0.015em; }

	.album-desc {
		margin: 0; font-size: 0.84rem; line-height: 1.6; color: var(--ink-soft);
		display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
	}

	.album-meta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--hair); }
	.loc { display: inline-flex; align-items: center; gap: 0.25rem; }

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.album:hover { transform: translateY(-4px); box-shadow: var(--lift-3); }
		.album:hover .album-art { transform: scale(1.04); }
	}

	.empty { padding: 3.5rem 1rem; text-align: center; color: var(--ink-soft); }
</style>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
	const cards = document.querySelectorAll<HTMLElement>(".album");
	const noMatch = document.getElementById("no-match");

	for (const chip of chips) {
		chip.addEventListener("click", () => {
			const want = chip.dataset.tag || "";
			for (const c of chips) c.classList.toggle("is-on", c === chip);
			let shown = 0;
			for (const card of cards) {
				const tags: string[] = JSON.parse(card.dataset.tags || "[]");
				const hit = !want || tags.includes(want);
				card.hidden = !hit;
				if (hit) shown++;
			}
			if (noMatch) noMatch.hidden = shown > 0;
		});
	}
</script>
