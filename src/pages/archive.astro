---
// 归档严格按时间倒序；筛选保持 ?tag= / ?category= / ?uncategorized=true。
import { Icon } from "astro-icon/components";
import SitePage from "@/layouts/SitePage.astro";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

const posts = (await getSortedPostsList())
	.slice()
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const categories = await getCategoryList();
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.published.getFullYear();
	if (!grouped.has(year)) grouped.set(year, []);
	grouped.get(year)?.push(post);
}
const groups = [...grouped.entries()]
	.map(([year, list]) => ({ year, list }))
	.sort((a, b) => b.year - a.year);

function monthDay(date: Date): string {
	return `${String(date.getMonth() + 1).padStart(2, "0")}/${String(date.getDate()).padStart(2, "0")}`;
}
---

<SitePage title="文章索引" lede={`共 ${posts.length} 篇文章，按时间排列。`}>
	<div class="archive-layout">
		<div class="archive-main">
			<nav class="archive-filter" aria-label="按主题筛选文章">
				<a href={url("/archive/")} data-archive-filter aria-current="page">全部 <span>{posts.length}</span></a>
				{categories.map((category) => (
					<a href={category.url} data-archive-filter>{category.name}<span>{category.count}</span></a>
				))}
			</nav>
			<p id="filter-status" class="filter-status" role="status" aria-live="polite" aria-atomic="true">
				显示全部 {posts.length} 篇文章。
			</p>
			<div id="filter-bar" class="filter-bar" hidden>
				<span class="filter-value" id="filter-value"></span>
				<a href={url("/archive/")} class="filter-clear"><Icon is:inline name="lucide:x" /><span>清除筛选</span></a>
			</div>
			<div class="empty" id="empty" hidden>
				<h2>没有找到匹配的文章</h2>
				<p>换一个主题，或回到全部记录。</p>
				<a href={url("/archive/")}>查看全部文章</a>
			</div>
			{
				groups.map(({ year, list }) => (
					<section class="year-group" data-year={year}>
						<h2 class="year"><span>{year}</span><span class="year-count">{list.length} 篇</span></h2>
						<ul class="rows">
							{list.map((post) => (
								<li class="row" data-tags={JSON.stringify(post.data.tags)} data-category={post.data.category || ""}>
									<a href={getPostUrlBySlug(post.id)}>
										<time class="row-date" datetime={post.data.published.toISOString()}>{monthDay(post.data.published)}</time>
										<span class="row-title">{post.data.title}{post.data.password && <span class="lock-label">受保护</span>}</span>
										<span class="row-cat">{post.data.category || "未分类"}</span>
										<Icon is:inline name="lucide:arrow-up-right" class="row-arrow" />
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
		<aside class="archive-aside" aria-labelledby="archive-reading-title">
			<h2 id="archive-reading-title">更多阅读方式</h2>
			<nav aria-label="更多阅读方式">
				<a href={url("/tags/")}><Icon is:inline name="lucide:tags" /><span>标签</span></a>
				<a href={url("/categories/")}><Icon is:inline name="lucide:folder-open" /><span>分类</span></a>
				<a href={url("/series/")}><Icon is:inline name="lucide:layers" /><span>专题</span></a>
			</nav>
		</aside>
	</div>
</SitePage>

<style>
	.filter-bar[hidden], .empty[hidden], .year-group[hidden], .row[hidden] { display: none; }
	.archive-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; align-items: start; gap: clamp(32px, 5vw, 64px); }
	.archive-main { min-width: 0; }
	.archive-filter { display: flex; flex-wrap: wrap; gap: 8px; }
	.archive-filter a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 14px; border: 1px solid var(--hair); border-radius: var(--radius-sm); background: var(--card); color: var(--ink-soft); font-size: 13px; text-decoration: none; }
	.archive-filter a:hover { border-color: var(--accent); color: var(--accent); }
	.archive-filter a[aria-current] { border-color: var(--accent); background: var(--accent-wash); color: var(--accent); font-weight: 600; }
	.archive-filter span { font-size: 12px; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
	.filter-status { margin: 16px 0 24px; font-size: 12px; line-height: 1.8; color: var(--ink-soft); }
	.filter-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; padding: 12px 16px; margin-bottom: 24px; border-radius: var(--radius-sm); background: var(--accent-wash); }
	.filter-value { font-size: 14px; font-weight: 600; color: var(--accent); }
	.filter-clear { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; color: var(--ink-soft); font-size: 12px; text-decoration: none; }
	.filter-clear:hover { color: var(--accent); }
	.filter-clear svg { width: 15px; height: 15px; }
	.empty { padding: 40px 24px; text-align: center; border: 1px solid var(--hair); border-radius: var(--radius); background: var(--card); }
	.empty h2 { margin: 0; font-size: 20px; font-weight: 650; }
	.empty p { color: var(--ink-soft); font-size: 14px; line-height: 1.8; }
	.empty a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; }
	.year-group { margin-bottom: 40px; }
	.year { display: flex; align-items: baseline; gap: 16px; margin: 0 0 16px; color: var(--ink); font-size: 28px; line-height: 1.4; font-weight: 600; letter-spacing: -0.025em; }
	.year-count { color: var(--ink-soft); font-size: 12px; font-weight: 400; letter-spacing: 0; }
	.rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair); }
	.row { border-bottom: 1px solid var(--hair); }
	.row a { display: grid; grid-template-columns: 48px minmax(0, 1fr) 18px; align-items: start; gap: 8px 20px; padding: 20px 0; color: inherit; text-decoration: none; }
	.row a:hover .row-title { color: var(--accent); }
	.row-date { color: var(--ink-soft); font-family: var(--mono); font-size: 12px; font-variant-numeric: tabular-nums; padding-top: 4px; }
	.row-title { min-width: 0; font-size: 16px; font-weight: 600; line-height: 1.8; letter-spacing: -0.012em; }
	.lock-label { margin-left: 8px; vertical-align: middle; font-weight: 400; letter-spacing: 0; white-space: nowrap; }
	.row-cat { grid-column: 2; grid-row: 2; color: var(--ink-soft); font-size: 12px; line-height: 1.5; }
	.row-arrow { grid-column: 3; grid-row: 1; width: 16px; height: 16px; margin-top: 6px; color: var(--ink-soft); }
	.archive-aside { min-width: 0; padding-block: 20px; border-block: 1px solid var(--hair); }
	.archive-aside h2 { font-size: 16px; font-weight: 650; line-height: 1.5; margin: 0 0 12px; }
	.archive-aside nav { display: flex; flex-direction: column; gap: 4px; }
	.archive-aside a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--ink-soft); font-size: 13px; text-decoration: none; }
	.archive-aside a:hover { text-decoration: underline; }
	.archive-aside svg { width: 16px; height: 16px; color: var(--accent); }
	@media (max-width: 900px) {
		.archive-layout { grid-template-columns: 1fr; gap: 16px; }
		.archive-aside nav { flex-direction: row; flex-wrap: wrap; gap: 8px 28px; }
	}
	@media (max-width: 600px) {
		.archive-filter a { padding-inline: 12px; }
		.row a { grid-template-columns: 42px minmax(0, 1fr); column-gap: 16px; padding-block: 20px; }
		.row-title { font-size: 15px; }
		.row-arrow { display: none; }
		.year { font-size: 25px; }
	}
</style>

<script>
	const params = new URLSearchParams(location.search);
	const tag = params.get("tag");
	const category = params.get("category");
	const uncategorized = params.get("uncategorized") === "true";
	const hasFilter = Boolean(tag || category || uncategorized);
	let shown = 0;

	for (const group of document.querySelectorAll<HTMLElement>(".year-group")) {
		let visible = 0;
		for (const row of group.querySelectorAll<HTMLElement>(".row")) {
			const tags: string[] = JSON.parse(row.dataset.tags || "[]");
			const rowCategory = row.dataset.category || "";
			const hit = !hasFilter || (tag
				? tags.includes(tag)
				: uncategorized
					? rowCategory === ""
					: rowCategory === category);
			row.hidden = !hit;
			if (hit) visible++;
		}
		group.hidden = visible === 0;
		const count = group.querySelector(".year-count");
		if (count) count.textContent = `${visible} 篇`;
		shown += visible;
	}

	for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-archive-filter]")) {
		const linkParams = new URL(link.href).searchParams;
		const isCurrent = !hasFilter
			? !linkParams.toString()
			: !tag && (uncategorized
				? linkParams.get("uncategorized") === "true"
				: linkParams.get("category") === category);
		if (isCurrent) link.setAttribute("aria-current", "page");
		else link.removeAttribute("aria-current");
	}

	const label = tag ? `#${tag}` : uncategorized ? "未分类" : (category || "");
	const bar = document.getElementById("filter-bar");
	const value = document.getElementById("filter-value");
	const status = document.getElementById("filter-status");
	const empty = document.getElementById("empty");
	if (bar) bar.hidden = !hasFilter;
	if (value) value.textContent = label;
	if (status) status.textContent = hasFilter ? `「${label}」下有 ${shown} 篇文章。` : `显示全部 ${shown} 篇文章。`;
	if (empty) empty.hidden = shown > 0;
</script>
