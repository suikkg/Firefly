---
// 友链：卡片来自 friendsConfig，自定义内容来自 spec/friends
import { Icon } from "astro-icon/components";
import Comment from "@/components/comment/index.astro";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	profileConfig,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import LabPage from "@/layouts/LabPage.astro";
import { hueFromString } from "@/utils/lab-utils";
import "@/styles/lab-prose.css";

// 页面开关关闭时保持与旧版一致的行为
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

// 说明：spec/friends.mdx 是主题自带的模板，整篇用 Tailwind 工具类写成
// （grid-cols / w-3 h-3 之类）。新版界面不加载 Tailwind，那些类全部失效，
// 渲染出来是一团散排。这里改成用 config 里的真实站点信息原生渲染，
// 内容文件本身未做改动。
const selfInfo = [
	{ label: "站点名称", value: siteConfig.title },
	{ label: "站点描述", value: siteConfig.subtitle || siteConfig.description },
	{ label: "站点链接", value: siteConfig.site_url },
	{ label: "头像链接", value: profileConfig.avatar },
].filter((f) => !!f.value);

const isCommentEnabled =
	!!commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

const friends = getEnabledFriends();
const allTags = [...new Set(friends.flatMap((f) => f.tags || []))].sort();

const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description =
	friendsPageConfig.description || i18n(I18nKey.friendsDescription);
---

<LabPage title={title} description={description} lede={description}>
	{
		allTags.length > 0 && (
			<div class="tag-filter" role="group" aria-label="按标签筛选">
				<button type="button" class="chip is-on" data-tag="">
					全部 <span class="chip-n">{friends.length}</span>
				</button>
				{allTags.map((t) => (
					<button type="button" class="chip" data-tag={t}>
						{t}
						<span class="chip-n">
							{friends.filter((f) => (f.tags || []).includes(t)).length}
						</span>
					</button>
				))}
			</div>
		)
	}

	{
		friends.length === 0 ? (
			<p class="empty">还没有添加友链</p>
		) : (
			<div class="friends">
				{friends.map((f) => (
					<a
						class="friend card"
						href={f.siteurl}
						target="_blank"
						rel="noopener noreferrer"
						data-tags={JSON.stringify(f.tags || [])}
						style={`--h:${hueFromString(f.title)}`}
					>
						<img
							class="avatar"
							src={f.imgurl}
							alt=""
							loading="lazy"
							decoding="async"
							referrerpolicy="no-referrer"
						/>
						<div class="friend-body">
							<h2 class="friend-name">{f.title}</h2>
							<p class="friend-desc">{f.desc}</p>
							{(f.tags || []).length > 0 && (
								<div class="friend-tags micro">
									{(f.tags || []).map((t) => (
										<span>{t}</span>
									))}
								</div>
							)}
						</div>
						<Icon is:inline name="lucide:arrow-up-right" class="friend-arrow" />
					</a>
				))}
			</div>
		)
	}

	<p class="empty" id="no-match" hidden>该标签下没有友链</p>

	<section class="self">
		<h2 class="self-title">申请友链</h2>
		<p class="self-lede">
			想交换友链的话，把下面这些信息添加到你的站点，然后在评论区留言告诉我。
		</p>

		<dl class="self-fields">
			{
				selfInfo.map((f) => (
					<div class="field">
						<div class="field-text">
							<dt class="micro">{f.label}</dt>
							<dd>{f.value}</dd>
						</div>
						<button type="button" class="copy" data-copy={f.value} aria-label={`复制${f.label}`}>
							<Icon is:inline name="lucide:copy" class="copy-idle" />
							<Icon is:inline name="lucide:check" class="copy-done" />
						</button>
					</div>
				))
			}
		</dl>
	</section>

	{
		isCommentEnabled && (
			<section class="comments">
				<h2 class="comments-title micro">评论</h2>
				<Comment customPath="/friends" title={title} />
			</section>
		)
	}
</LabPage>

<style>
	.chip[hidden],
	.empty[hidden],
	.friend[hidden] {
		display: none;
	}

	/* ── 标签筛选 ───────────────────────────────────────── */
	.tag-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.9rem;
		border: 0;
		border-radius: 999px;
		background: var(--card);
		box-shadow: var(--lift-1);
		color: var(--ink);
		font-family: inherit;
		font-size: 0.82rem;
		cursor: pointer;
		transition:
			background-color 0.3s var(--ease-out),
			color 0.3s var(--ease-out),
			transform 0.4s var(--spring);
	}

	.chip:hover { transform: translateY(-2px); }
	.chip.is-on { background: var(--accent); color: #fff; }

	.chip-n {
		font-family: var(--mono);
		font-size: 0.7em;
		opacity: 0.65;
	}

	/* ── 友链卡片 ───────────────────────────────────────── */
	.friends {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
		gap: 1rem;
	}

	.friend {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1rem 2.4rem 1rem 1rem;
		color: inherit;
		text-decoration: none;
		overflow: hidden;
	}

	/* 左侧一道色条，颜色由站名派生，卡片之间有区分又不脱离整体色调 */
	.friend::before {
		content: "";
		position: absolute;
		inset: 0 auto 0 0;
		width: 3px;
		background: oklch(0.72 0.12 var(--h));
	}

	.avatar {
		width: 3.1rem;
		height: 3.1rem;
		flex-shrink: 0;
		border-radius: 50%;
		object-fit: cover;
		background: var(--accent-wash);
	}

	.friend-body { min-width: 0; }

	.friend-name {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 650;
		letter-spacing: -0.012em;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.friend-desc {
		margin: 0.25rem 0 0;
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--ink-soft);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.friend-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.45rem;
		letter-spacing: 0.1em;
	}

	.friend-tags span {
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: var(--accent-wash);
		color: var(--accent-deep);
	}

	.friend-arrow {
		position: absolute;
		right: 0.9rem;
		top: 0.9rem;
		font-size: 0.9rem;
		color: var(--ink-mute);
		opacity: 0;
		transform: translate3d(-0.2rem, 0.2rem, 0);
		transition:
			opacity 0.35s var(--ease-out),
			transform 0.45s var(--spring),
			color 0.3s var(--ease-out);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.friend:hover { transform: translateY(-3px); box-shadow: var(--lift-3); }
		.friend:hover .friend-arrow {
			opacity: 1;
			transform: none;
			color: oklch(0.58 0.13 var(--h));
		}
	}

	.empty {
		padding: 3rem 1rem;
		text-align: center;
		color: var(--ink-soft);
	}

	/* ── 本站信息 ───────────────────────────────────────── */
	.self {
		max-width: var(--measure);
		margin-top: clamp(2.5rem, 6vw, 4rem);
		padding-top: clamp(1.5rem, 4vw, 2.5rem);
		border-top: 1px solid var(--hair);
	}

	.self-title {
		margin: 0 0 0.5rem;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.self-lede {
		margin: 0 0 1.25rem;
		font-size: 0.92rem;
		line-height: 1.75;
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	.self-fields {
		display: grid;
		gap: 0.5rem;
		margin: 0;
	}

	.field {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.65rem 0.9rem;
		border-radius: var(--radius-sm);
		background: var(--card);
		box-shadow: var(--lift-1);
	}

	.field-text { min-width: 0; }

	.field dt { margin: 0 0 0.15rem; }

	.field dd {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 500;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.copy {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.9rem;
		height: 1.9rem;
		border: 0;
		border-radius: var(--radius-sm);
		background: var(--accent-wash);
		color: var(--accent-deep);
		cursor: pointer;
		font-size: 0.85rem;
		transition: background-color 0.25s var(--ease-out);
	}

	.copy:hover { background: var(--accent); color: #fff; }

	/* 复制成功时把图标换成对勾 */
	.copy .copy-done { display: none; }
	.copy.is-done .copy-idle { display: none; }
	.copy.is-done .copy-done { display: block; }
	.copy.is-done { background: var(--accent); color: #fff; }

	.comments {
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	.comments-title {
		margin: 0 0 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--hair);
	}

	.comments :global(#post-comments) { max-width: var(--measure); }
	.comments :global(#post-comments > .absolute) { display: none; }
</style>

<script>
	// 标签筛选：纯前端显隐，数据构建期已就绪
	const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
	const cards = document.querySelectorAll<HTMLElement>(".friend");
	const noMatch = document.getElementById("no-match");

	// 复制站点信息
	for (const btn of document.querySelectorAll<HTMLButtonElement>(".copy")) {
		btn.addEventListener("click", async () => {
			const text = btn.dataset.copy;
			if (!text) return;
			try {
				await navigator.clipboard.writeText(text);
			} catch {
				// 非安全上下文或用户拒绝授权时静默失败，不打断页面
				return;
			}
			btn.classList.add("is-done");
			window.setTimeout(() => btn.classList.remove("is-done"), 1500);
		});
	}

	for (const chip of chips) {
		chip.addEventListener("click", () => {
			const want = chip.dataset.tag || "";
			for (const c of chips) c.classList.toggle("is-on", c === chip);

			let shown = 0;
			for (const card of cards) {
				const tags: string[] = JSON.parse(card.dataset.tags || "[]");
				const hit = !want || tags.includes(want);
				card.hidden = !hit;
				if (hit) shown++;
			}
			if (noMatch) noMatch.hidden = shown > 0;
		});
	}
</script>
