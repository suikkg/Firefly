---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";
import KatexManager from "@/components/features/KatexManager.astro";
import { personalConfig, profileConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import SitePage from "@/layouts/SitePage.astro";
import "@/styles/site-prose.css";

const aboutPost = await getEntry("spec", "about");
if (!aboutPost) {
	throw new Error("About page content not found");
}
const { Content } = await render(aboutPost);
const contactLinks = profileConfig.links.filter((link) =>
	["github", "email"].includes(link.name.toLowerCase()),
);
---

<SitePage title={i18n(I18nKey.about)} description={`${profileConfig.name} 的个人博客。`}>
	<KatexManager slot="head" />
	<section class="identity" aria-labelledby="identity-title">
		<div class="nameplate" aria-hidden="true">
			<span>{profileConfig.name}</span>
			<p>个人博客</p>
		</div>
		<div class="identity-copy">
			<h2 id="identity-title">{personalConfig.greeting}</h2>
			<p class="identity-bio">{profileConfig.bio}</p>
			<nav class="contact-links" aria-label="联系 KK">
				{contactLinks.map((link) => (
					<a href={link.url}>
						<Icon is:inline name={link.icon} />
						<span>{link.name.toLowerCase() === "email" ? "写邮件" : link.name}</span>
					</a>
				))}
			</nav>
		</div>
	</section>

	<!-- 完整保留 Markdown 内容与它原有的标题锚点、联系和开源署名。 -->
	<article class="prose site-prose about">
		<Content />
	</article>
</SitePage>

<style>
	.identity { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: center; margin-bottom: 40px; }
	.nameplate { align-self: stretch; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px; padding: 32px; border: 1px solid var(--hair); border-radius: var(--radius); background: var(--card); }
	.nameplate > span { font-family: var(--signature); font-size: 76px; font-style: italic; letter-spacing: -5px; line-height: 1; }
	.nameplate p { margin: 16px 0 0; font-size: 13px; font-weight: 550; color: var(--ink-soft); }
	.identity-copy { min-width: 0; max-width: 660px; }
	.identity-copy h2 { margin: 0 0 16px; font-size: clamp(26px, 3vw, 36px); font-weight: 650; line-height: 1.4; letter-spacing: -0.025em; }
	.identity-bio { margin: 0 0 12px; font-size: 17px; line-height: 1.8; }
	.contact-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
	.contact-links a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 8px 16px; border: 1px solid var(--hair); border-radius: var(--radius-sm); background: var(--card); color: var(--ink); text-decoration: none; font-size: 13px; }
	.contact-links a:hover { border-color: var(--accent); color: var(--accent); }
	.contact-links svg { width: 16px; height: 16px; }
	.about { padding-inline: 0; }
	@media (max-width: 700px) {
		.identity { grid-template-columns: 1fr; gap: 28px; margin-bottom: 32px; }
		.nameplate { min-height: 0; flex-direction: row; gap: 24px; padding: 24px; justify-content: flex-start; }
		.nameplate > span { font-size: 56px; letter-spacing: -3px; }
		.nameplate p { margin: 0 0 0 auto; font-size: 12px; }
		.identity-bio { font-size: 16px; }
	}
	@media (max-width: 380px) { .nameplate { gap: 16px; padding: 20px; } }
</style>
